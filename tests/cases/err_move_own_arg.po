# ERROR: error[E-MOVE-1]: 移動済みの値 'name' を使っています
# ERROR: 'name' はここで移動しました
# 第22章：own 引数へ渡すと移動する（既定の借用では移動しない）
def take(s: own str) -> int:
    return len(s)

def main() -> int:
    name: str = "polonium"
    n: int = take(name)
    return n + len(name)
