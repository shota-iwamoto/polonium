# OUTPUT: 16302.58788
# OUTPUT: ok
# EXIT: 0
# FLAGS: -O2
# 第46章：panic の経路がインライン化を止めていないこと
#
#   ⚠️ linalg.Matrix.get / set は小さなメソッドです。**外れの経路**
#     （範囲外・桁あふれ・None）の呼び出しが増えると、LLVM のインライン化の
#     見積り（cost）がしきい値を超え、内側ループに呼び出しが戻ります。
#     実測でそれが 2 回起きました。
#       第46章 … check の中にメッセージ組み立てを直接書いていた（143 → 62 ms）
#       第48章 … 桁あふれ検査で分岐と呼び出しが 2 つ増えた（cost=225 / threshold=225）
#
#   ★ いま効いている 3 つ。どれが戻ってもここで遅くなります。
#     ① codegen が panic / pl_index_fail などに付ける **cold**
#     ② lib/linalg.po の Matrix.index_fail / len_fail への切り出し
#     ③ 添字の中の桁あふれを**範囲検査に相乗り**させる（第48章。gen_index_expr）
#
# ★ 第54章：**比べる相手を変えました。**
#   はじめは「二重リストの行列積」と比べていましたが、それは
#   **データの並べ方まで違う**ので、機械が変わると比も変わります
#   （macOS 2.1 に対して CI の Linux は 4.28。インライン化は効いているのに
#     番人が鳴りました）。
#
#   いまは **まったく同じ計算を、同じ平坦な list[float] に直接書いたもの**と
#   比べます。違いは「get / set を通すかどうか」**だけ**です。
#
#     畳まれているとき   … 1.1 前後
#     畳まれないとき     … 3.4 前後（-mllvm -inline-threshold=120 で確認）
#     しきい値           … 2.0
#
#   ⚠️ -O0 では誰もインライン化しないので差が出ません。# FLAGS: -O2 が要ります。
import linalg
import time

N: int = 256

def make_flat(seed: int) -> list[float]:
    d: list[float] = []
    s: int = seed
    for i in range(N * N):
        s = (s * 1103515 + 12345) % 2147483648
        d.append(float(s % 1000) / 1000.0)
    return d

def main() -> int:
    # ── A: linalg.Matrix（get / set を通す）──
    am: linalg.Matrix = linalg.Matrix(N, N, make_flat(1))
    bm: linalg.Matrix = linalg.Matrix(N, N, make_flat(7))
    t0: int = time.monotonic_ns()
    cm: linalg.Matrix = linalg.matmul(am, bm)
    t_mat: int = time.since_ns(t0)

    # ── B: まったく同じ計算を、平坦な list[float] に直接書く ──
    a: list[float] = make_flat(1)
    b: list[float] = make_flat(7)
    c: list[float] = []
    for i in range(N * N):
        c.append(0.0)
    t0 = time.monotonic_ns()
    for i in range(N):
        for k in range(N):
            aik: float = a[i * N + k]
            for j in range(N):
                c[i * N + j] = c[i * N + j] + aik * b[k * N + j]
    t_flat: int = time.since_ns(t0)

    t: float = 0.0
    for i in range(N):
        t = t + cm.get(i, i)
    print(str(t))

    # 答えが同じであること（速いが間違っている、を弾く）
    if cm.get(1, 1) != c[N + 1]:
        print("NG 答えが違います")
        return 1

    ratio: float = float(t_mat) / float(t_flat)
    if ratio > 2.0:
        print("NG get/set がインライン化されていません: linalg / 直書き = " +
              str(ratio))
        print("   （make inline-report で cost と threshold を見てください）")
        return 1
    print("ok")
    return 0
