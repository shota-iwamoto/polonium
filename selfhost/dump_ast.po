# dump_ast.po — stage1 の構文解析器を動かす入口（第17章）
#
#   ./build/stage1-ast foo.po
#
# ★ C 版の `poloniumc --dump-ast foo.po` と**バイト単位で同じ出力**を目指します。
import io
import sys
import token
import lexer
import ast
import parser

def main() -> int:
    args: list[str] = sys.argv()
    if len(args) < 2:
        print("使い方: stage1-ast <入力.po>")
        return 1

    path: str = args[1]
    src: str = io.read_file(path)
    toks: list[token.Token] = lexer.tokenize(path, src)
    root: ast.Node = parser.parse(toks)
    ast.dump_ast(root)
    return 0
