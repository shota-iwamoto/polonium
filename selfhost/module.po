# module.po — モジュールの読み込み（第18章）
#
# ★ src/module.c の移植です。入口のファイルから import をたどり、
#   依存が先に並んだ順（トポロジカル順）で返します。
#   循環 import は 3 値の state で検出します（第13章）。
import io
import strings
import sys
import ast
import diag
import langinfo
import lexer
import parser
import token

# 標準ライブラリの場所。
#
# ⚠️ C 版はビルド時に埋め込みます（-DPLC_LIB_DIR）が、Polonium には
#   プリプロセッサがありません。**環境変数 PLC_LIB_DIR**で受け取り、
#   無ければ "lib" を使います。C 版も同じ環境変数を先に見るようにしたので、
#   両者は同じ規則で探します（ch18 18.6 節）。
DEFAULT_LIB_DIR: str = "lib"

def lib_dir() -> str:
    env: str = sys.getenv("PLC_LIB_DIR")
    if len(env) > 0:
        return env
    return DEFAULT_LIB_DIR


class Module:
    name: str    # "lexer"（IR の名前修飾に使う）
    path: str    # "…/lexer.po"
    dir: str     # import を探すディレクトリ（入口ファイルのある場所）
    src: str
    ast: ast.Node | None

    deps: list[Module]

    ll_path: str

    # 深さ優先探索の状態（0=未訪問 / 1=訪問中 / 2=完了）
    state: int

    next: Module | None   # 依存順のリスト（依存が先）

    def init(self, name: str, path: str, dir_: str) -> None:
        self.name = name
        self.path = path
        self.dir = dir_
        self.src = ""
        self.ll_path = ""
        self.state = 0
        self.deps = []


class Loader:
    dir: str
    loaded: list[Module]
    order: Module | None
    order_tail: Module | None
    stack: list[Module]

    def init(self, dir_: str) -> None:
        self.dir = dir_
        self.loaded = []
        self.stack = []


# "a/b/lexer.po" → "a/b"（区切りが無ければ "."）
def dir_of(path: str) -> str:
    i: int = len(path) - 1
    while i >= 0:
        if strings.byte_at(path, i) == 47:   # '/'
            if i == 0:
                return "/"
            return strings.substr(path, 0, i)
        i = i - 1
    return "."

# "a/b/lexer.po" → "lexer"
def module_name_of(path: str) -> str:
    base: str = path
    i: int = len(path) - 1
    while i >= 0:
        if strings.byte_at(path, i) == 47:
            base = strings.substr(path, i + 1, len(path) - i - 1)
            i = -1
        else:
            i = i - 1

    n: int = len(base)
    elen: int = langinfo.ext_len()
    if n > elen and strings.endswith(base, langinfo.ext()):
        n = n - elen

    out: list[str] = []
    j: int = 0
    while j < n:
        b: int = strings.byte_at(base, j)
        ok: bool = ((b >= 97 and b <= 122) or (b >= 65 and b <= 90) or b == 95 or
                    (j > 0 and b >= 48 and b <= 57))
        if ok:
            out.append(chr(b))
        else:
            out.append("_")
        j = j + 1
    if n == 0:
        return "m"
    return strings.join(out, "")

def join_path(dir_: str, name: str) -> str:
    if dir_ == ".":
        return name + langinfo.ext()
    return dir_ + "/" + name + langinfo.ext()

# モジュールを探す（入口のディレクトリと lib/。両方にあればエラー）
def path_for(ld: Loader, name: str, from_: token.Token | None) -> str:
    user: str = join_path(ld.dir, name)
    lib: str = join_path(lib_dir(), name)

    has_user: bool = io.exists(user)
    has_lib: bool = io.exists(lib)

    if has_user and has_lib and user != lib:
        if from_ is None:
            panic("モジュール '" + name + "' が標準ライブラリと衝突しています")
        else:
            diag.error_full(from_,
                            "モジュール '" + name + "' が標準ライブラリと衝突しています",
                            "どちらを指しているか決められません", None, "",
                            "見つかった場所:\n             " + user +
                            "\n             " + lib +
                            "\n             どちらかの名前を変えてください")
    if has_lib and not has_user:
        return lib
    return user

# dir に <name>.po があるか（「import を書き忘れていませんか」の診断用）
def file_exists(dir_: str, name: str) -> bool:
    return io.exists(join_path(dir_, name))

def find_module(ld: Loader, name: str) -> Module | None:
    i: int = 0
    while i < len(ld.loaded):
        m: Module = ld.loaded[i]
        if m.name == name:
            return m
        i = i + 1
    return None

# 循環の経路を "main → lexer → parser → lexer" の形にする
def cycle_path(ld: Loader, name: str) -> str:
    parts: list[str] = []
    started: bool = False
    i: int = 0
    while i < len(ld.stack):
        m: Module = ld.stack[i]
        if not started and m.name == name:
            started = True
        if started:
            parts.append(m.name)
        i = i + 1
    parts.append(name)
    return strings.join(parts, " → ")


# ★ 再帰から戻るときに order へ積むと、それだけでトポロジカル順になる
def load(ld: Loader, name: str, path: str, from_: token.Token | None) -> Module:
    found: Module | None = find_module(ld, name)
    if found is not None:
        if found.state == 1:   # 訪問中に再訪 → 循環
            if from_ is None:
                panic("循環 import です")
            else:
                diag.error_full(from_,
                                "循環 import です: " + cycle_path(ld, name),
                                "この import が循環を作っています", None, "",
                                "モジュールの依存関係は一方通行（DAG）にしてください。" +
                                "共通部分を 3 つ目のモジュールに切り出すと解けます")
        return found

    if from_ is not None and not io.exists(path):
        diag.error_full(from_, "モジュール '" + name + "' が見つかりません",
                        "この import を解決できません", None, "",
                        "次のパスを探しました:\n             " + path +
                        "\n             モジュール名はファイル名（" + langinfo.ext() +
                        " を除いたもの）です")

    m: Module = Module(name, path, ld.dir)
    m.src = io.read_file(path)
    m.state = 1

    # ★ 構文解析より前に表へ載せる（そうしないと循環を検出できない）
    ld.loaded.append(m)

    toks: list[token.Token] = lexer.tokenize(m.path, m.src)
    m.ast = parser.parse(toks)

    ld.stack.append(m)
    root: ast.Node | None = m.ast
    if root is not None:
        d: ast.Node | None = root.body
        while d is not None:
            if d.kind == ast.ND_IMPORT:
                if d.name == m.name:
                    diag.error_at_hint(tok_of(d),
                                       "モジュールは自分自身を import できません",
                                       "'" + d.name + "' は自分自身です")
                k: int = 0
                while k < len(m.deps):
                    if m.deps[k].name == d.name:
                        diag.error_full(tok_of(d),
                                        "'" + d.name + "' は既に import されています",
                                        "重複した import です", None, "",
                                        "同じモジュールを 2 回書く必要はありません")
                    k = k + 1
                dep: Module = load(ld, d.name, path_for(ld, d.name, tok_of(d)),
                                   tok_of(d))
                m.deps.append(dep)
            d = d.next
    ld.stack = pop_last(ld.stack)

    m.state = 2

    # ★ 再帰から戻るときに積むので、依存が必ず自分より前に並ぶ
    tail: Module | None = ld.order_tail
    if tail is None:
        ld.order = m
    else:
        tail.next = m
    ld.order_tail = m
    return m


# list に pop が無いので作り直す（第16章と同じ割り切り）
def pop_last(xs: list[Module]) -> list[Module]:
    out: list[Module] = []
    i: int = 0
    while i < len(xs) - 1:
        out.append(xs[i])
        i = i + 1
    return out

def tok_of(n: ast.Node) -> token.Token:
    t: token.Token | None = n.tok
    if t is None:
        panic("module: node without token")
        return token.Token(0, "", 0, 0, "", 0, 0)
    else:
        return t


# 入口ファイルから import をたどって全モジュールを読む
def load_modules(entry_path: str) -> Module | None:
    ld: Loader = Loader(dir_of(entry_path))
    load(ld, module_name_of(entry_path), entry_path, None)
    return ld.order

def entry_of(mods: Module | None, entry_path: str) -> Module | None:
    name: str = module_name_of(entry_path)
    m: Module | None = mods
    while m is not None:
        if m.name == name:
            return m
        m = m.next
    return None
