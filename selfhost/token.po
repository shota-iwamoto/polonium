# token.po — トークンの表現（第16章）
#
# ★ src/lexer.h の TokenKind と Token を Polonium に移したものです。
#   値と順序は C 版に揃えます（揃えないと --dump-tokens の比較ができません）。
#
# ⚠️ Polonium には enum がないので、グローバル定数で代用します
#   （言語仕様 6.2：初期化式はコンパイル時定数）。

TK_EOF: int = 0
TK_INT: int = 1
TK_PUNCT: int = 2
TK_IDENT: int = 3
TK_KEYWORD: int = 4
TK_STR: int = 5
TK_NEWLINE: int = 6
TK_INDENT: int = 7
TK_DEDENT: int = 8

# --dump-tokens に出す名前（C 版の token_kind_name と同じ文字列）
def kind_name(kind: int) -> str:
    if kind == TK_EOF:
        return "EOF"
    if kind == TK_INT:
        return "INT"
    if kind == TK_PUNCT:
        return "PUNCT"
    if kind == TK_IDENT:
        return "IDENT"
    if kind == TK_KEYWORD:
        return "KEYWORD"
    if kind == TK_STR:
        return "STR"
    if kind == TK_NEWLINE:
        return "NEWLINE"
    if kind == TK_INDENT:
        return "INDENT"
    if kind == TK_DEDENT:
        return "DEDENT"
    panic("token.kind_name: unknown kind")
    return ""


class Token:
    kind: int

    # ── 位置情報（エラー報告に使う。全トークンが必ず持つ）──
    file: str
    line: int
    col: int         # 行頭からのバイト数（1 起算）。C 版の Token.col と同じ

    # ★ 第18章：C 版と同じ形に戻しました。
    #   C 版の Token は `const char *line_start`（ソースを指すポインタ）を
    #   持ちます。Polonium にポインタは無いので「ソースそのもの + 行頭の添字」で
    #   同じことを表します。str は参照なので、複製は起きません。
    src: str         # このトークンが属するソース全体
    line_start: int  # 行頭のバイト位置
    len: int         # トークンのバイト長（下線の長さに使う）

    # ── ソース上の実体 ──
    #
    # ⚠️ C 版は「ソースを指すポインタ + 長さ」でしたが、Polonium には
    #   ポインタがないので、その範囲を複製して持ちます（ch16 16.5 節）。
    raw: str   # 見た目そのまま（STR なら引用符やエスケープを含む）
    text: str  # 値（STR はエスケープ解決後 / IDENT・KEYWORD は名前）
    ival: int  # TK_INT の値
    slen: int  # text のバイト長

    def init(self, kind: int, file: str, line: int, col: int, src: str,
             line_start: int, length: int) -> None:
        self.kind = kind
        self.file = copy(file)
        self.line = line
        self.col = col
        self.src = copy(src)
        self.line_start = line_start
        self.len = length
        self.raw = ""
        self.text = ""
        self.ival = 0
        self.slen = 0

    def is_punct(self, op: str) -> bool:
        return self.kind == TK_PUNCT and self.raw == op

    def is_kw(self, kw: str) -> bool:
        return self.kind == TK_KEYWORD and self.text == kw
