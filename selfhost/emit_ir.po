# emit_ir.po — stage1 のコード生成器を動かす入口（第19章）
#
#   ./build/stage1-codegen foo.po
#
# ★ C 版の `poloniumc -S foo.po` と**バイト単位で同じ出力**を目指します。
import io
import sys
import strings
import module
import sema
import codegen

def main() -> int:
    args: list[str] = sys.argv()
    if len(args) < 2:
        print("使い方: stage1-codegen <入力.po>")
        return 1

    path: str = args[1]

    # ⚠️ target triple はビルド時に埋め込めない（プリプロセッサが無い）ので、
    #   環境変数から受け取ります。第18章の PLC_LIB_DIR と同じ手です。
    triple: str = sys.getenv("PLC_TARGET_TRIPLE")

    mods: module.Module | None = module.load_modules(path)
    entry: module.Module | None = module.entry_of(mods, path)
    sema.sema_program(mods, entry)

    if entry is None:
        panic("emit_ir: 入口モジュールがありません")
        return 1

    main_ir: str = entry.name + ".main"

    # 複数モジュールなら区切りを入れて並べる（C 版の -S と同じ）
    multi: bool = False
    if mods is not None:
        first: module.Module = mods
        if first.next is not None:
            multi = True

    m: module.Module | None = mods
    while m is not None:
        mm: module.Module = m
        if multi:
            print("; ── module: " + mm.name + " ──")
        name: str = ""
        if mm.name == entry.name:
            name = main_ir
        io.print_raw(codegen.codegen(mm, name, triple))
        m = mm.next
    return 0
