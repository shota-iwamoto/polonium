# parser.po — 構文解析器（第17章）
#
# ★ src/parser.c の移植です。**機械的に移しています。**
#   関数名・優先順位の階層・判定の順序を C 版と揃えてあるので、
#   S 式が食い違ったときに diff で追えます（ch16 16.1 節の規律）。
#
# ⚠️ 診断の描画（src/diag.c）はまだ移植していません。
#   位置とメッセージだけを出して止まります（第18章で本物にします）。
import strings
import diag
import ast
import token
import lexer


class Parser:
    toks: list[token.Token]
    pos: int
    hidden: int   # 隠し変数の連番（第11章の for の脱糖で使う）

    def init(self, toks: list[token.Token]) -> None:
        self.toks = toks
        self.pos = 0
        self.hidden = 0

    # ── トークンの読み取り ──────────────────────────────────

    def peek(self) -> token.Token:
        return self.toks[self.pos]

    # n 個先を覗く（消費しない）。EOF より先は EOF を返す
    def peek_at(self, n: int) -> token.Token:
        i: int = self.pos + n
        if i >= len(self.toks):
            i = len(self.toks) - 1
        return self.toks[i]

    def advance(mut self) -> token.Token:
        t: token.Token = self.peek()
        if t.kind != token.TK_EOF:
            self.pos = self.pos + 1
        return t

    # 現在のトークンが指定した記号なら消費して返す。違えば None
    def consume(mut self, op: str) -> token.Token | None:
        if self.peek().is_punct(op):
            return self.advance()
        return None

    def consume_kw(mut self, kw: str) -> token.Token | None:
        if self.peek().is_kw(kw):
            return self.advance()
        return None

    # ノードの代表トークンを取り出す。
    # ★ 「起きないはず」を panic で受けるのは、C 版の UNREACHABLE() と同じ手です。
    def tok_of(self, n: ast.Node) -> token.Token:
        t: token.Token | None = n.tok
        if t is None:
            # ⚠️ panic は戻りませんが、stage0 の到達可能性検査はそれを知りません
            #   （C 版の _Noreturn にあたる印が無い）。else で書きます。
            panic("parser: node without token")
            return self.peek()
        else:
            return t

    # ★ 第18章：診断の描画を diag.po に載せ替えました。
    #   メッセージ・ラベル・ヒントの文言も C 版と 1 対 1 に揃えます。
    def fail(self, t: token.Token, msg: str) -> None:
        diag.error_at(t, msg)

    def fail_hint(self, t: token.Token, hint: str, msg: str) -> None:
        diag.error_at_hint(t, hint, msg)

    def fail_full(self, t: token.Token, msg: str, label: str, hint: str) -> None:
        diag.error_full(t, msg, label, None, "", hint)

    def expect_close(mut self, close: str, open_tok: token.Token) -> token.Token:
        t: token.Token = self.peek()
        if t.is_punct(close):
            return self.advance()
        diag.error_full(t, "閉じ括弧 '" + close + "' がありません",
                        "ここに '" + close + "' が必要です",
                        open_tok, "対応する '" + open_tok.raw + "' はここです",
                        "括弧の対応を確認してください")
        return t

    # トークン種別の日本語名（C 版 tok_kind_ja）
    def kind_ja(self, kind: int) -> str:
        if kind == token.TK_EOF:
            return "ファイルの終わり"
        if kind == token.TK_INT:
            return "整数"
        if kind == token.TK_FLOAT:
            return "浮動小数点数"
        if kind == token.TK_PUNCT:
            return "記号"
        if kind == token.TK_IDENT:
            return "名前"
        if kind == token.TK_KEYWORD:
            return "予約語"
        if kind == token.TK_STR:
            return "文字列"
        if kind == token.TK_NEWLINE:
            return "改行"
        if kind == token.TK_INDENT:
            return "字下げ"
        if kind == token.TK_DEDENT:
            return "字下げの終わり"
        panic("parser: unknown token kind")
        return ""

    def expect(mut self, kind: int, what: str, hint: str) -> token.Token:
        t: token.Token = self.peek()
        if t.kind == kind:
            return self.advance()
        diag.error_full(t, what + "が必要です", "ここは" + self.kind_ja(t.kind) + "です",
                        None, "", hint)
        return t

    def expect_newline(mut self) -> None:
        t: token.Token = self.peek()
        if t.kind != token.TK_NEWLINE:
            diag.error_full(t, "文の後に余分なトークンがあります",
                            "ここから先が解釈できません", None, "",
                            "1 行に書けるのは 1 つの文です（改行で区切ってください）")
        self.advance()

    def expect_colon(mut self, what: str) -> None:
        if self.consume(":") is not None:
            return
        diag.error_full(self.peek(), what + "の後に ':' が必要です",
                        "ここに ':' が必要です", None, "",
                        "ブロックを開く行は ':' で終わり、次の行を字下げします")

    # ── 式（優先順位の階層。C 版と同じ順序で並べる）────────

    # primary ::= INT | STR | IDENT | None | True | False | "(" expr ")" | list
    # f"..." を連結式に脱糖する（第37章）
    #
    #   f"a{x}b"  →  "a" + str(x) + "b"
    #
    # ★ 埋め込んだ式は **その場で字句解析し直して**構文解析します。
    #   ⚠️ 中身は必ず str(...) で包みます（パーサの時点では型が分からない）。
    # ⚠️ 波括弧そのものは {{ }} と重ねます（Python と同じ）。
    def fstring(mut self, t: token.Token) -> ast.Node:
        src: str = t.text
        result: ast.Node | None = None
        lit: list[str] = []
        i: int = 0

        while i < len(src):
            c: str = src[i]
            nx: str = ""
            if i + 1 < len(src):
                nx = src[i + 1]

            if c == "{" and nx == "{":
                lit.append("{")
                i = i + 2
                continue
            if c == "}" and nx == "}":
                lit.append("}")
                i = i + 2
                continue
            if c == "}":
                self.fail_full(t, "f-string に対応しない '}' があります",
                               "ここです", "'}' そのものを書くには '}}' と重ねてください")
            if c != "{":
                lit.append(c)
                i = i + 1
                continue

            # ── 埋め込み式 ──
            joined: str = strings.join(lit, "")
            if len(joined) > 0:
                sn: ast.Node = ast.new_str_node(t, joined, len(joined))
                if result is not None:
                    result = ast.new_binop_node(t, ast.OP_ADD, result, sn)
                else:
                    result = sn
                lit = []

            i = i + 1                      # '{'
            ex_start: int = i
            depth: int = 1
            while i < len(src) and depth > 0:
                ch: str = src[i]
                if ch == "{":
                    depth = depth + 1
                elif ch == "}":
                    depth = depth - 1
                if depth > 0:
                    i = i + 1
            if depth != 0:
                self.fail_full(t, "f-string の '{' が閉じられていません",
                               "ここです", "")
            ex: str = strings.substr(src, ex_start, i - ex_start)
            i = i + 1                      # '}'

            if len(ex) == 0:
                self.fail_full(t, "f-string の '{}' が空です",
                               "ここに式が必要です", "")

            # ⚠️ tokenize は行末に改行を要求するので足します
            sub: Parser = Parser(lexer.tokenize(t.file, ex + "\n"))
            inner: ast.Node = sub.expr()

            # ⚠️ **式を最後まで読み切ったかを確かめる。**
            #    これが無いと f"{x:>8}" のような書式指定が「x」だけ読まれて
            #    **黙って無視される**（エラーにするより悪い）。
            rest: token.Token = sub.peek()
            if rest.kind != token.TK_NEWLINE and rest.kind != token.TK_EOF:
                self.fail_full(t,
                               "f-string の中の式を解釈できません: '" + ex + "'",
                               "ここです",
                               "書式指定（f\"{x:>8}\" のような桁揃え）はありません。" +
                               "strings.lpad / strings.rpad を使ってください")

            call: ast.Node = ast.new_node(ast.ND_CALL, t)
            call.name = "str"
            call.args = inner

            if result is not None:
                result = ast.new_binop_node(t, ast.OP_ADD, result, call)
            else:
                result = call

        joined2: str = strings.join(lit, "")
        if len(joined2) > 0:
            sn2: ast.Node = ast.new_str_node(t, joined2, len(joined2))
            if result is not None:
                result = ast.new_binop_node(t, ast.OP_ADD, result, sn2)
            else:
                result = sn2

        if result is not None:
            return result
        return ast.new_str_node(t, "", 0)

    def primary(mut self) -> ast.Node:
        open_tok: token.Token | None = self.consume("(")
        if open_tok is not None:
            n: ast.Node = self.expr()
            self.expect_close(")", open_tok)
            return n

        t: token.Token = self.peek()
        if t.kind == token.TK_INT:
            self.advance()
            return ast.new_int_node(t, t.ival)
        if t.kind == token.TK_FLOAT:
            self.advance()
            return ast.new_float_node(t, copy(t.text))
        if t.kind == token.TK_IDENT:
            self.advance()
            return ast.new_var_node(t, t.text)
        if t.kind == token.TK_STR:
            self.advance()
            return ast.new_str_node(t, t.text, t.slen)
        if t.kind == token.TK_FSTRING:
            self.advance()
            return self.fstring(t)

        # None リテラル（第15章）
        if t.is_kw("None"):
            self.advance()
            return ast.new_node(ast.ND_NONE, t)

        # リストリテラル [1, 2, 3]（第10章）
        if t.is_punct("["):
            self.advance()
            n2: ast.Node = ast.new_node(ast.ND_LIST, t)
            head: ast.Node = ast.new_node(ast.ND_BLOCK, t)   # ダミーの先頭
            cur: ast.Node = head
            if not self.peek().is_punct("]"):
                while True:
                    cur.next = self.expr()
                    nx: ast.Node | None = cur.next
                    if nx is None:
                        panic("parser: unreachable")
                    else:
                        cur = nx
                    if self.consume(",") is None:
                        break
                    if self.peek().is_punct("]"):
                        break   # 末尾のカンマを許す
            self.expect_close("]", t)
            n2.body = head.next
            return n2

        # True / False は予約語だが式として使える
        # ★ 「予約語はエラー」の判定より前に置くこと
        if t.is_kw("True"):
            self.advance()
            return ast.new_bool_node(t, True)
        if t.is_kw("False"):
            self.advance()
            return ast.new_bool_node(t, False)

        if t.kind == token.TK_KEYWORD:
            self.fail_hint(t, "予約語は変数名として使えません（言語仕様 2.5）",
                           "'" + t.text + "' は予約語です")

        label: str = "ここには式が来るはずです"
        if t.kind == token.TK_EOF:
            label = "ここでファイルが終わっています"
        self.fail_full(t, "式が必要です", label,
                       "式とは整数リテラル、変数名、または '(' で囲んだ式のことです")
        return ast.new_node(ast.ND_PASS, t)

    # postfix ::= primary { "[" expr "]" | "." IDENT [ "(" args ")" ] | "(" args ")" }
    def postfix(mut self) -> ast.Node:
        n: ast.Node = self.primary()

        while True:
            open_tok: token.Token = self.peek()

            # 添字 xs[i]（第10章）とスライス xs[a:b]（第37章）
            if self.consume("[") is not None:
                lo: ast.Node | None = None
                if not self.peek().is_punct(":"):
                    lo = self.expr()

                if self.consume(":") is not None:
                    sl: ast.Node = ast.new_node(ast.ND_SLICE, open_tok)
                    sl.lhs = n
                    sl.rhs = lo
                    if not self.peek().is_punct("]"):
                        sl.els = self.expr()
                    self.expect_close("]", open_tok)
                    n = sl
                    continue

                idx: ast.Node = ast.new_node(ast.ND_INDEX, open_tok)
                idx.lhs = n
                idx.rhs = lo
                self.expect_close("]", open_tok)
                n = idx
                continue

            # メソッド呼び出し / フィールドアクセス（第10・12章）
            if self.consume(".") is not None:
                name_tok: token.Token = self.peek()
                if name_tok.kind != token.TK_IDENT:
                    self.fail_hint(name_tok,
                                   "'.' の後にはフィールド名かメソッド名を書きます" +
                                   "（例: t.kind / xs.append(1)）",
                                   "フィールド名かメソッド名が必要です")
                self.advance()

                mopen: token.Token = self.peek()
                if not mopen.is_punct("("):
                    f: ast.Node = ast.new_node(ast.ND_FIELD, name_tok)
                    f.lhs = n
                    f.name = name_tok.text
                    n = f
                    continue
                self.advance()

                m: ast.Node = ast.new_node(ast.ND_METHOD, name_tok)
                m.lhs = n
                m.name = name_tok.text
                m.args = self.arg_list(mopen)
                n = m
                continue

            if self.consume("(") is None:
                return n

            # 呼べるのは名前だけ（第一級関数は v1 未対応）
            if n.kind != ast.ND_VAR:
                self.fail_full(self.tok_of(n), "この式は呼び出せません",
                               "呼び出せるのは関数の名前だけです",
                               "関数を値として扱うことは v1 では対応していません")

            call: ast.Node = ast.new_node(ast.ND_CALL, n.tok)
            call.name = n.name
            call.args = self.arg_list(open_tok)
            n = call
        return n

    # 引数リストを読む（閉じ括弧まで）。C 版は各所に展開されているが、
    # Polonium 版はダミー先頭の扱いが冗長になるので 1 か所にまとめる。
    def arg_list(mut self, open_tok: token.Token) -> ast.Node | None:
        head: ast.Node = ast.new_node(ast.ND_BLOCK, open_tok)
        cur: ast.Node = head
        if not self.peek().is_punct(")"):
            while True:
                cur.next = self.expr()
                nx: ast.Node | None = cur.next
                if nx is None:
                    panic("parser: unreachable")
                else:
                    cur = nx
                if self.consume(",") is None:
                    break
        self.expect_close(")", open_tok)
        return head.next

    # power ::= postfix [ "**" unary ]（右結合）
    def power(mut self) -> ast.Node:
        base: ast.Node = self.postfix()
        t: token.Token = self.peek()
        if self.consume("**") is not None:
            return ast.new_binop_node(t, ast.OP_POW, base, self.unary())
        return base

    # unary ::= ("-" | "+" | "~") unary | power（右結合）
    def unary(mut self) -> ast.Node:
        t: token.Token = self.peek()
        if self.consume("-") is not None:
            return ast.new_unary_node(t, ast.OP_NEG, self.unary())
        if self.consume("+") is not None:
            return ast.new_unary_node(t, ast.OP_POS, self.unary())
        if self.consume("~") is not None:
            return ast.new_unary_node(t, ast.OP_BITNOT, self.unary())
        return self.power()

    # mul_expr ::= unary { ("*" | "/" | "//" | "%") unary }（左結合）
    def mul_expr(mut self) -> ast.Node:
        lhs: ast.Node = self.unary()
        while True:
            t: token.Token = self.peek()
            # ★ "//" を "/" より先に判定すること
            if self.consume("//") is not None:
                lhs = ast.new_binop_node(t, ast.OP_FLOORDIV, lhs, self.unary())
            elif self.consume("*") is not None:
                lhs = ast.new_binop_node(t, ast.OP_MUL, lhs, self.unary())
            elif self.consume("/") is not None:
                lhs = ast.new_binop_node(t, ast.OP_TRUEDIV, lhs, self.unary())
            elif self.consume("%") is not None:
                lhs = ast.new_binop_node(t, ast.OP_MOD, lhs, self.unary())
            else:
                return lhs
        return lhs

    def add_expr(mut self) -> ast.Node:
        lhs: ast.Node = self.mul_expr()
        while True:
            t: token.Token = self.peek()
            if self.consume("+") is not None:
                lhs = ast.new_binop_node(t, ast.OP_ADD, lhs, self.mul_expr())
            elif self.consume("-") is not None:
                lhs = ast.new_binop_node(t, ast.OP_SUB, lhs, self.mul_expr())
            else:
                return lhs
        return lhs

    def shift_expr(mut self) -> ast.Node:
        lhs: ast.Node = self.add_expr()
        while True:
            t: token.Token = self.peek()
            if self.consume("<<") is not None:
                lhs = ast.new_binop_node(t, ast.OP_SHL, lhs, self.add_expr())
            elif self.consume(">>") is not None:
                lhs = ast.new_binop_node(t, ast.OP_SHR, lhs, self.add_expr())
            else:
                return lhs
        return lhs

    def bitand_expr(mut self) -> ast.Node:
        lhs: ast.Node = self.shift_expr()
        while True:
            t: token.Token = self.peek()
            if self.consume("&") is not None:
                lhs = ast.new_binop_node(t, ast.OP_BITAND, lhs, self.shift_expr())
            else:
                return lhs
        return lhs

    def bitxor_expr(mut self) -> ast.Node:
        lhs: ast.Node = self.bitand_expr()
        while True:
            t: token.Token = self.peek()
            if self.consume("^") is not None:
                lhs = ast.new_binop_node(t, ast.OP_BITXOR, lhs, self.bitand_expr())
            else:
                return lhs
        return lhs

    def bitor_expr(mut self) -> ast.Node:
        lhs: ast.Node = self.bitxor_expr()
        while True:
            t: token.Token = self.peek()
            if self.consume("|") is not None:
                lhs = ast.new_binop_node(t, ast.OP_BITOR, lhs, self.bitxor_expr())
            else:
                return lhs
        return lhs

    # 比較演算子なら対応する OpKind を返す。違えば -1
    def compare_op(self, t: token.Token) -> int:
        if t.is_punct("=="):
            return ast.OP_EQ
        if t.is_punct("!="):
            return ast.OP_NE
        if t.is_punct("<="):
            return ast.OP_LE
        if t.is_punct(">="):
            return ast.OP_GE
        if t.is_punct("<"):
            return ast.OP_LT
        if t.is_punct(">"):
            return ast.OP_GT
        return -1

    # comparison ::= bitor_expr [ compop bitor_expr ]
    # ⚠️ 連鎖しません（while ではなく if）
    def comparison(mut self) -> ast.Node:
        lhs: ast.Node = self.bitor_expr()

        # ★ 第15章：is / is not。右辺は None だけを許す（sema が検査）
        is_tok: token.Token = self.peek()
        if is_tok.is_kw("is"):
            self.advance()
            op: int = ast.OP_IS
            if self.consume_kw("not") is not None:
                op = ast.OP_ISNOT
            return ast.new_binop_node(is_tok, op, lhs, self.bitor_expr())

        # ★ 第37章：in / not in。比較と同じ段（Python と同じ優先度）
        in_tok: token.Token = self.peek()
        if in_tok.is_kw("in"):
            self.advance()
            return ast.new_binop_node(in_tok, ast.OP_IN, lhs, self.bitor_expr())
        if in_tok.is_kw("not") and self.peek_at(1).is_kw("in"):
            self.advance()
            self.advance()
            return ast.new_binop_node(in_tok, ast.OP_NOTIN, lhs, self.bitor_expr())

        t: token.Token = self.peek()
        cop: int = self.compare_op(t)
        if cop < 0:
            return lhs
        self.advance()

        rhs: ast.Node = self.bitor_expr()

        # ★ 比較の連鎖を禁止する（構文の段階で捕まえる）
        if self.compare_op(self.peek()) >= 0:
            diag.error_full(self.peek(), "比較演算子を連鎖させることはできません",
                            "2 つ目の比較演算子です",
                            t, "1 つ目の比較演算子はここです",
                            "Python と違い連鎖比較は使えません。'and' で繋いでください" +
                            "（例: a < b and b < c）")

        return ast.new_binop_node(t, cop, lhs, rhs)

    # not_expr ::= "not" not_expr | comparison（右結合）
    def not_expr(mut self) -> ast.Node:
        t: token.Token = self.peek()
        if self.consume_kw("not") is not None:
            return ast.new_unary_node(t, ast.OP_NOT, self.not_expr())
        return self.comparison()

    # and_expr ::= not_expr { "and" not_expr }
    def and_expr(mut self) -> ast.Node:
        lhs: ast.Node = self.not_expr()
        while True:
            t: token.Token = self.peek()
            if self.consume_kw("and") is not None:
                lhs = ast.new_logical_node(t, ast.OP_AND, lhs, self.not_expr())
            else:
                return lhs
        return lhs

    # or_expr ::= and_expr { "or" and_expr }
    def or_expr(mut self) -> ast.Node:
        lhs: ast.Node = self.and_expr()
        while True:
            t: token.Token = self.peek()
            if self.consume_kw("or") is not None:
                lhs = ast.new_logical_node(t, ast.OP_OR, lhs, self.and_expr())
            else:
                return lhs
        return lhs

    # expr ::= or_expr [ "if" or_expr "else" expr ]（第37章）
    #
    # ★ いちばん優先度が低いので or_expr の外側に 1 段だけ積みます。
    # ⚠️ else 側は expr（自分自身）なので **右結合**（Python と同じ）
    def expr(mut self) -> ast.Node:
        lhs: ast.Node = self.or_expr()
        t: token.Token = self.peek()
        if not t.is_kw("if"):
            return lhs
        self.advance()

        n: ast.Node = ast.new_node(ast.ND_COND, t)
        n.rhs = lhs                 # 条件が真のときの値（前に書く）
        n.lhs = self.or_expr()      # 条件
        if self.consume_kw("else") is None:
            diag.error_full(self.peek(), "三項演算子に 'else' がありません",
                            "ここに 'else' が必要です", None, "",
                            "書き方は 'a if 条件 else b' です（値を返す式なので、" +
                            "条件が偽のときの値も必ず要ります）")
        n.els = self.expr()         # 偽のときの値
        return n

    # ── 文 ──────────────────────────────────────────────────

    # var_decl ::= IDENT ":" type "=" expr
    def var_decl(mut self) -> ast.Node:
        name_tok: token.Token = self.advance()   # IDENT（呼び出し元が確認済み）
        self.advance()                           # ":"

        tr: ast.Node = self.type_ref("型注釈には型名を書きます（例: x: int = 0）")

        if not self.peek().is_punct("="):
            self.fail_full(self.peek(), "変数宣言には初期化式が必要です",
                           "ここに '= 初期値' が必要です",
                           "Polonium では未初期化の変数を作れません（例: x: int = 0）")
        self.advance()   # "="

        n: ast.Node = ast.new_node(ast.ND_VARDECL, name_tok)
        n.name = name_tok.text
        n.type_ref = tr
        n.rhs = self.expr()
        return n

    # 複合代入の記号なら、対応する演算子を返す。違えば -1
    def aug_op(self, t: token.Token) -> int:
        if t.is_punct("+="):
            return ast.OP_ADD
        if t.is_punct("-="):
            return ast.OP_SUB
        if t.is_punct("*="):
            return ast.OP_MUL
        if t.is_punct("//="):
            return ast.OP_FLOORDIV
        if t.is_punct("%="):
            return ast.OP_MOD
        return -1

    # 脱糖で作る隠し変数の名前。
    # ⚠️ 連番の振り方まで C 版と揃えること（S 式に名前が出るため）
    def hidden_name(mut self, tag: str) -> str:
        name: str = tag + "." + str(self.hidden)
        self.hidden = self.hidden + 1
        return name

    # 隠し変数の宣言（型注釈なし = 初期化式の型を使う。第11章）
    def hidden_decl(self, tok: token.Token | None, name: str,
                    init: ast.Node | None) -> ast.Node:
        n: ast.Node = ast.new_node(ast.ND_VARDECL, tok)
        n.name = copy(name)
        n.rhs = init
        return n

    # 代入先と同じ形のノードを、対象を隠し変数に差し替えて作り直す
    def retarget(self, target: ast.Node, obj: str, idx: str) -> ast.Node:
        n: ast.Node = ast.new_node(target.kind, target.tok)
        n.lhs = ast.new_var_node(target.tok, obj)
        if target.kind == ast.ND_INDEX:
            n.rhs = ast.new_var_node(target.tok, idx)
        else:
            n.name = target.name   # ND_FIELD
        return n

    # 複合代入の脱糖（言語仕様 5.2）
    def aug_assign(mut self, t: token.Token, op: int, target: ast.Node,
                   rhs: ast.Node) -> ast.Node:
        # 変数はそのまま（2 回評価しても副作用がない）
        if target.kind == ast.ND_VAR:
            n: ast.Node = ast.new_node(ast.ND_ASSIGN, t)
            n.lhs = target
            n.rhs = ast.new_binop_node(t, op,
                                       ast.new_var_node(target.tok, target.name),
                                       rhs)
            return n

        head: ast.Node = ast.new_node(ast.ND_BLOCK, t)
        cur: ast.Node = head

        obj: str = self.hidden_name("aug.obj")
        decl: ast.Node = self.hidden_decl(target.tok, obj, target.lhs)
        cur.next = decl
        cur = decl

        idx: str = ""
        if target.kind == ast.ND_INDEX:
            idx = self.hidden_name("aug.idx")
            decl2: ast.Node = self.hidden_decl(target.tok, idx, target.rhs)
            cur.next = decl2
            cur = decl2

        asg: ast.Node = ast.new_node(ast.ND_ASSIGN, t)
        asg.lhs = self.retarget(target, obj, idx)                    # 書き
        asg.rhs = ast.new_binop_node(t, op, self.retarget(target, obj, idx),
                                     rhs)                            # 読み
        cur.next = asg

        # 隠し変数をこの文の中に閉じ込めるため、ブロックで包む
        blk: ast.Node = ast.new_node(ast.ND_BLOCK, t)
        blk.body = head.next
        return blk

    # simple_stmt ::= var_decl | assign_stmt | expr_stmt
    def simple_stmt(mut self) -> ast.Node:
        t0: token.Token = self.peek()

        if t0.is_kw("break"):
            self.advance()
            return ast.new_node(ast.ND_BREAK, t0)
        if t0.is_kw("continue"):
            self.advance()
            return ast.new_node(ast.ND_CONTINUE, t0)
        if t0.is_kw("pass"):
            self.advance()
            return ast.new_node(ast.ND_PASS, t0)

        # assert_stmt ::= "assert" expr [ "," expr ]（第37章）
        #
        # ★ **パーサで脱糖する**：assert cond, msg → if not cond: panic(msg)
        #   新しいノードも意味解析の規則も要らない（elif と同じ手）。
        # ⚠️ if の本体は必ず ND_BLOCK にすること（後段がそれを前提にしている）
        if t0.is_kw("assert"):
            self.advance()
            cond: ast.Node = self.expr()

            msg: ast.Node = ast.new_str_node(t0, "", 0)
            if self.peek().is_punct(","):
                self.advance()
                msg = self.expr()
            else:
                dm: str = ("assertion failed: " + t0.file + ":" + str(t0.line))
                msg = ast.new_str_node(t0, dm, len(dm))

            call: ast.Node = ast.new_node(ast.ND_CALL, t0)
            call.name = "panic"
            call.args = msg

            body: ast.Node = ast.new_node(ast.ND_BLOCK, t0)
            body.body = call

            ifn: ast.Node = ast.new_node(ast.ND_IF, t0)
            ifn.lhs = ast.new_unary_node(t0, ast.OP_NOT, cond)
            ifn.body = body
            return ifn

        # raise_stmt ::= "raise" expr（第27章）
        if t0.is_kw("raise"):
            self.advance()
            rz: ast.Node = ast.new_node(ast.ND_RAISE, t0)
            rz.lhs = self.expr()
            return rz

        # return_stmt ::= "return" [ expr ]
        if t0.is_kw("return"):
            self.advance()
            r: ast.Node = ast.new_node(ast.ND_RETURN, t0)
            # 値の有無は「次が改行か」で判断する
            if self.peek().kind != token.TK_NEWLINE:
                r.lhs = self.expr()
            return r

        # IDENT の次が ':' なら変数宣言（2 トークン先読み）
        if self.peek().kind == token.TK_IDENT and self.peek_at(1).is_punct(":"):
            return self.var_decl()

        lhs: ast.Node = self.expr()
        t: token.Token = self.peek()

        aug: int = self.aug_op(t)
        if not t.is_punct("=") and aug < 0:
            # 式文になれるのは呼び出しだけ
            # ⚠️ 位置は「左辺のトークン」（C 版と揃える）
            if lhs.kind != ast.ND_CALL and lhs.kind != ast.ND_METHOD:
                self.fail_full(self.tok_of(lhs), "この式は文として書けません",
                               "計算した値がどこにも使われていません",
                               "結果を変数に代入するか、関数の呼び出しを書いてください")
            return lhs

        # ここから代入。左辺が代入先になれるか確認する
        if (lhs.kind != ast.ND_VAR and lhs.kind != ast.ND_INDEX and
                lhs.kind != ast.ND_FIELD):
            self.fail_full(self.tok_of(lhs), "この式には代入できません",
                           "代入先にできるのは変数・添字 xs[i]・フィールド t.f だけです",
                           "計算結果を代入したい場合は、左辺に変数を書いてください")
        self.advance()   # "=" または複合代入記号

        rhs: ast.Node = self.expr()

        if aug >= 0:
            return self.aug_assign(t, aug, lhs, rhs)

        n2: ast.Node = ast.new_node(ast.ND_ASSIGN, t)
        n2.lhs = lhs
        n2.rhs = rhs
        return n2

    # block ::= NEWLINE INDENT stmt { stmt } DEDENT
    def block(mut self) -> ast.Node:
        head_tok: token.Token = self.peek()

        self.expect(token.TK_NEWLINE, "改行",
                    "':' の後は改行してブロックを字下げしてください")
        self.expect(token.TK_INDENT, "字下げされたブロック",
                    "':' の次の行は字下げしてください（スペース 4 個を推奨）")

        head: ast.Node = ast.new_node(ast.ND_BLOCK, head_tok)
        cur: ast.Node = head
        # ⚠️ TK_EOF も終了条件に入れる（万一のときの無限ループ避け）
        while (self.peek().kind != token.TK_DEDENT and
               self.peek().kind != token.TK_EOF):
            st: ast.Node = self.stmt()
            cur.next = st
            cur = st
        self.expect(token.TK_DEDENT, "ブロックの終わり", "")

        blk: ast.Node = ast.new_node(ast.ND_BLOCK, head_tok)
        blk.body = head.next
        return blk

    # if_stmt ::= "if" expr ":" block { "elif" ... } [ "else" ":" block ]
    #
    # ★ elif は「else の中に if が 1 個ある」形に脱糖する（再帰 1 行）
    def if_stmt(mut self) -> ast.Node:
        t: token.Token = self.advance()   # "if" または "elif"

        n: ast.Node = ast.new_node(ast.ND_IF, t)
        n.lhs = self.expr()
        self.expect_colon("if の条件")
        n.body = self.block()

        if self.peek().is_kw("elif"):
            n.els = self.if_stmt()
        elif self.consume_kw("else") is not None:
            self.expect_colon("'else'")
            n.els = self.block()
        return n

    # for_stmt ::= "for" IDENT "in" expr ":" block
    #
    # ★ for は while への脱糖（第11章）。隠し変数の連番まで C 版に揃える。
    # list をまわる for の脱糖（第11章。第39章で enumerate と共用にした）
    #
    #   for x in xs:                → idx_tok は None
    #   for i, x in enumerate(xs):  → idx_tok が添字の変数
    #
    # ★ 違いは「隠しの添字変数を、利用者の名前でも束縛するか」だけ。
    def for_over_list(mut self, t: token.Token, iter_: ast.Node,
                      var_tok: token.Token, idx_tok: token.Token | None,
                      body: ast.Node) -> ast.Node:
        head: ast.Node = ast.new_node(ast.ND_BLOCK, t)
        cur: ast.Node = head

        ix: str = self.hidden_name("for.ix")

        it: str = self.hidden_name("for.it")
        d2: ast.Node = self.hidden_decl(t, it, iter_)
        cur.next = d2
        cur = d2

        d3: ast.Node = self.hidden_decl(t, ix, ast.new_int_node(t, 0))
        cur.next = d3
        cur = d3

        lencall: ast.Node = ast.new_node(ast.ND_CALL, t)
        lencall.name = "len"
        lencall.args = ast.new_var_node(t, it)
        cond: ast.Node = ast.new_binop_node(t, ast.OP_LT,
                                            ast.new_var_node(t, ix), lencall)

        idxn: ast.Node = ast.new_node(ast.ND_INDEX, t)
        idxn.lhs = ast.new_var_node(t, it)
        idxn.rhs = ast.new_var_node(t, ix)
        bind: ast.Node = self.hidden_decl(t, var_tok.text, idxn)

        # ★ enumerate なら、添字も利用者の名前で束縛する（i = for.ix.N）
        if idx_tok is not None:
            ibind: ast.Node = self.hidden_decl(t, idx_tok.text,
                                               ast.new_var_node(t, ix))
            ibind.next = bind
            bind = ibind

        last: ast.Node = bind
        nxt: ast.Node | None = last.next
        while nxt is not None:
            last = nxt
            nxt = last.next
        last.next = body.body
        body.body = bind

        inc: ast.Node = ast.new_node(ast.ND_ASSIGN, t)
        inc.lhs = ast.new_var_node(t, ix)
        inc.rhs = ast.new_binop_node(t, ast.OP_ADD, ast.new_var_node(t, ix),
                                     ast.new_int_node(t, 1))

        wh: ast.Node = ast.new_node(ast.ND_WHILE, t)
        wh.lhs = cond
        wh.body = body
        wh.incr = inc
        cur.next = wh

        blk: ast.Node = ast.new_node(ast.ND_BLOCK, t)
        blk.body = head.next
        return blk

    def for_stmt(mut self) -> ast.Node:
        t: token.Token = self.advance()   # "for"

        var_tok: token.Token = self.peek()
        if var_tok.kind != token.TK_IDENT:
            self.fail_hint(var_tok,
                           "for のループ変数は名前で書きます（例: for x in xs:）",
                           "ループ変数の名前が必要です")
        self.advance()

        # ★ 第39章：for i, x in enumerate(xs)
        #
        # ⚠️ タプルはありません。**この形だけ**を特別に認めます
        #   （2 つ目の変数は「添字」に固定。一般の分解代入ではない）。
        idx_tok: token.Token | None = None
        if self.peek().is_punct(","):
            self.advance()
            idx_tok = var_tok           # 1 つ目が添字
            var_tok = self.peek()       # 2 つ目が要素
            if var_tok.kind != token.TK_IDENT:
                self.fail_hint(var_tok,
                               "書き方は 'for i, x in enumerate(xs):' です",
                               "2 つ目のループ変数の名前が必要です")
            self.advance()

        if self.consume_kw("in") is None:
            self.fail_hint(self.peek(), "for は「for 変数 in 対象:」の形で書きます",
                           "'in' が必要です")

        # range(...) は特別扱い（言語仕様 5.5）
        is_range: bool = (self.peek().kind == token.TK_IDENT and
                          self.peek().text == "range" and
                          self.peek_at(1).is_punct("("))

        # ★ 第39章：enumerate(xs) も特別扱い。**中身を剥がすだけ**。
        if (self.peek().kind == token.TK_IDENT and
                self.peek().text == "enumerate" and self.peek_at(1).is_punct("(")):
            if idx_tok is None:
                self.fail_full(self.peek(),
                               "enumerate には 2 つのループ変数が必要です",
                               "添字と要素の 2 つを受け取ります",
                               "書き方は 'for i, x in enumerate(xs):' です")
            self.advance()
            eopen: token.Token = self.advance()
            eiter: ast.Node = self.expr()
            self.expect_close(")", eopen)
            self.expect_colon("for の対象")
            ebody: ast.Node = self.block()
            return self.for_over_list(t, eiter, var_tok, idx_tok, ebody)

        if idx_tok is not None:
            self.fail_full(self.peek(),
                           "ループ変数を 2 つ書けるのは enumerate だけです",
                           "ここには enumerate(...) が必要です",
                           "タプルはありません。'for i, x in enumerate(xs):' の形だけです")

        iter_: ast.Node | None = None
        start: ast.Node | None = None
        stop: ast.Node | None = None
        step: int = 1

        if is_range:
            self.advance()                              # "range"
            open_tok: token.Token = self.advance()      # "("

            a1: ast.Node = self.expr()
            a2: ast.Node | None = None
            a3: ast.Node | None = None
            if self.consume(",") is not None:
                a2 = self.expr()
            if self.consume(",") is not None:
                a3 = self.expr()
            self.expect_close(")", open_tok)

            if a2 is None:
                start = ast.new_int_node(t, 0)
                stop = a1
            else:
                start = a1
                stop = a2

            if a3 is not None:
                # ⚠️ 増分は整数リテラルだけ（v1 の制限）
                sign: int = 1
                lit: ast.Node = a3
                if lit.kind == ast.ND_UNARY and lit.op == ast.OP_NEG:
                    sign = -1
                    inner: ast.Node | None = lit.lhs
                    if inner is None:
                        panic("parser: unary without operand")
                    else:
                        lit = inner
                if lit.kind != ast.ND_INT:
                    self.fail_hint(self.tok_of(a3),
                                   "増分は整数リテラルで書いてください" +
                                   "（例: range(0, 10, 2)）。" +
                                   "変数を使いたい場合は while で書けます",
                                   "range の増分が定数ではありません")
                step = sign * lit.ival
                if step == 0:
                    self.fail_hint(self.tok_of(a3), "増分が 0 だと無限ループになります",
                                   "range の増分に 0 は使えません")
        else:
            iter_ = self.expr()

        self.expect_colon("for の対象")
        body: ast.Node = self.block()

        # ── ここから脱糖 ──
        head: ast.Node = ast.new_node(ast.ND_BLOCK, t)
        cur: ast.Node = head

        ix: str = self.hidden_name("for.ix")
        cond: ast.Node = ast.new_int_node(t, 0)   # 下で必ず入れ替える
        bind: ast.Node = ast.new_node(ast.ND_PASS, t)

        if is_range:
            # for.ix.N: int = start
            d1: ast.Node = self.hidden_decl(t, ix, start)
            cur.next = d1
            cur = d1

            # 増分の符号で条件の向きが変わる
            cmp_op: int = ast.OP_LT
            if step <= 0:
                cmp_op = ast.OP_GT
            if stop is None:
                panic("parser: range without stop")
            else:
                cond = ast.new_binop_node(t, cmp_op, ast.new_var_node(t, ix), stop)

            # x = for.ix.N
            bind = self.hidden_decl(t, var_tok.text, ast.new_var_node(t, ix))
        else:
            # for.it.N = <対象>（★ 1 回だけ評価する）
            it: str = self.hidden_name("for.it")
            d2: ast.Node = self.hidden_decl(t, it, iter_)
            cur.next = d2
            cur = d2

            # for.ix.N: int = 0
            d3: ast.Node = self.hidden_decl(t, ix, ast.new_int_node(t, 0))
            cur.next = d3
            cur = d3

            # for.ix.N < len(for.it.N)
            lencall: ast.Node = ast.new_node(ast.ND_CALL, t)
            lencall.name = "len"
            lencall.args = ast.new_var_node(t, it)
            cond = ast.new_binop_node(t, ast.OP_LT, ast.new_var_node(t, ix),
                                      lencall)

            # x = for.it.N[for.ix.N]
            idxn: ast.Node = ast.new_node(ast.ND_INDEX, t)
            idxn.lhs = ast.new_var_node(t, it)
            idxn.rhs = ast.new_var_node(t, ix)
            bind = self.hidden_decl(t, var_tok.text, idxn)

        # 本体の先頭にループ変数の束縛を差し込む
        bind.next = body.body
        body.body = bind

        # for.ix.N += 1（または step）— ★ continue の飛び先になる
        inc: ast.Node = ast.new_node(ast.ND_ASSIGN, t)
        inc.lhs = ast.new_var_node(t, ix)
        inc.rhs = ast.new_binop_node(t, ast.OP_ADD, ast.new_var_node(t, ix),
                                     ast.new_int_node(t, step))

        wh: ast.Node = ast.new_node(ast.ND_WHILE, t)
        wh.lhs = cond
        wh.body = body
        wh.incr = inc

        cur.next = wh

        blk: ast.Node = ast.new_node(ast.ND_BLOCK, t)
        blk.body = head.next
        return blk

    # while_stmt ::= "while" expr ":" block
    def while_stmt(mut self) -> ast.Node:
        t: token.Token = self.advance()   # "while"

        n: ast.Node = ast.new_node(ast.ND_WHILE, t)
        n.lhs = self.expr()
        self.expect_colon("while の条件")
        n.body = self.block()
        return n

    # stmt ::= simple_stmt NEWLINE | if_stmt | while_stmt | for_stmt
    def stmt(mut self) -> ast.Node:
        t: token.Token = self.peek()

        if t.is_kw("if"):
            return self.if_stmt()
        if t.is_kw("while"):
            return self.while_stmt()
        if t.is_kw("for"):
            return self.for_stmt()
        if t.is_kw("try"):
            return self.try_stmt()

        # 対応する if が無い elif / else
        if t.is_kw("elif") or t.is_kw("else"):
            self.fail_full(t, "対応する if がない '" + t.text + "' です",
                           "この行に対応する 'if' が見つかりません",
                           "'elif' / 'else' は 'if' と同じ字下げの位置に書いてください")

        s: ast.Node = self.simple_stmt()
        self.expect_newline()
        return s

    # ── 型注釈 ──────────────────────────────────────────────

    def type_name_token(mut self, what: str) -> token.Token:
        t: token.Token = self.peek()
        if t.kind == token.TK_IDENT or t.is_kw("None"):
            self.advance()
            return t
        self.fail_hint(t, what, "型名が必要です")
        return t

    # type_ref ::= [ IDENT "." ] IDENT [ "[" type_ref "]" ] [ "|" None ]
    def type_ref(mut self, what: str) -> ast.Node:
        # ★ 第38章：関数型 fn(A, B) -> C
        #
        # ⚠️ 'fn' は **予約語にしていません。** 型の位置でだけ、識別子 "fn" の
        #    直後に '(' が来たときに関数型として読みます（既存のコードで
        #    fn という名前が使えなくなるのを避けるため）。
        ft: token.Token = self.peek()
        if ft.kind == token.TK_IDENT and ft.text == "fn" and self.peek_at(1).is_punct("("):
            self.advance()
            fopen: token.Token = self.advance()

            fnode: ast.Node = ast.new_node(ast.ND_TYPEREF, ft)
            fnode.name = "fn"

            tail: ast.Node | None = None
            if not self.peek().is_punct(")"):
                while True:
                    a: ast.Node = self.type_ref("引数の型を書いてください")
                    if tail is not None:
                        tail.next = a
                    else:
                        fnode.body = a
                    tail = a
                    if self.consume(",") is None:
                        break
            self.expect_close(")", fopen)

            if self.consume("->") is None:
                self.fail_full(self.peek(), "関数型には戻り型が必要です",
                               "ここに '->' と戻り型を書いてください",
                               "書き方は fn(int, str) -> bool です")
            fnode.rhs = self.type_ref("戻り型を書いてください")
            return fnode

        t: token.Token = self.type_name_token(what)

        n: ast.Node = ast.new_node(ast.ND_TYPEREF, t)
        n.name = t.text

        # モジュール修飾 lexer.Token（★ 1 段だけ）
        if self.peek().is_punct("."):
            self.advance()
            m: token.Token = self.type_name_token("モジュール修飾の後には型名を書きます")
            n.mod_name = n.name
            n.name = m.text
            n.tok = m
            if self.peek().is_punct("."):
                self.fail_hint(self.peek(),
                               "モジュールの修飾は 1 段だけです" +
                               "（パッケージはありません）",
                               "'" + n.mod_name + "." + n.name +
                               "' の後にさらに '.' は書けません")

        open_tok: token.Token = self.peek()
        if self.consume("[") is not None:
            n.lhs = self.type_ref("要素型を書いてください（例: list[int]）")
            self.expect_close("]", open_tok)

        # ★ 第15章：T | None
        if self.peek().is_punct("|"):
            bar: token.Token = self.advance()
            if not self.peek().is_kw("None"):
                self.fail_hint(self.peek(),
                               "型の '|' の後ろに書けるのは None だけです" +
                               "（共用体型はありません）",
                               "'| None' の形で書いてください")
            self.advance()
            n.nullable = True
            n.tok = bar
        return n

    # param ::= IDENT ":" [ "own" | "mut" ] type
    #          | [ "mut" ] "self"
    #
    # ★ 第21章：受け取り方（own / mut）を読む。**意味づけはまだしない。**
    #   own / mut は「型の前」に置く（言語仕様 v2 §11）。self だけ型注釈が
    #   無いので `mut self` と書く。
    def param(mut self, allow_self: bool) -> ast.Node:
        # 名前の前に書けるのは 'mut self' の mut だけ
        lead: token.Token | None = None
        if self.peek().is_kw("mut") or self.peek().is_kw("own"):
            lead = self.advance()

        name_tok: token.Token = self.peek()
        if name_tok.kind != token.TK_IDENT:
            self.fail_hint(name_tok, "引数は「名前: 型」の形で書きます（例: n: int）",
                           "引数名が必要です")
        self.advance()

        if (allow_self and name_tok.text == "self" and
                not self.peek().is_punct(":")):
            n0: ast.Node = ast.new_node(ast.ND_PARAM, name_tok)
            n0.name = name_tok.text
            if lead is not None:
                if lead.is_kw("own"):
                    self.fail_hint(lead,
                                   "self の所有権は奪えません（'mut self' なら書けます）",
                                   "self に 'own' は書けません")
                n0.mode = ast.PM_MUT
            return n0   # type_ref は None のまま（sema がクラスの型を入れる）

        if lead is not None:
            self.fail_hint(lead,
                           "'" + lead.text + "' は型の前に書きます（例: " +
                           name_tok.text + ": " + lead.text + " list[int]）",
                           "ここには書けません")

        if self.consume(":") is None:
            self.fail_hint(self.peek(), "引数には型注釈が必須です（例: n: int）",
                           "引数名の後に ':' が必要です")

        # ★ 第21章：型の前の own / mut
        mode: int = ast.PM_BORROW
        if self.consume_kw("own") is not None:
            mode = ast.PM_OWN
        elif self.consume_kw("mut") is not None:
            mode = ast.PM_MUT

        tr: ast.Node = self.type_ref("引数には型注釈が必須です（例: n: int）")

        n: ast.Node = ast.new_node(ast.ND_PARAM, name_tok)
        n.name = name_tok.text
        n.type_ref = tr
        n.mode = mode
        return n

    # 引数リスト（仮引数）を読む
    def param_list(mut self, open_tok: token.Token, in_class: bool) -> ast.Node | None:
        head: ast.Node = ast.new_node(ast.ND_BLOCK, open_tok)
        cur: ast.Node = head
        first: bool = True
        if not self.peek().is_punct(")"):
            while True:
                # self を書けるのは「クラス本体の中の、第 1 引数」だけ
                pm: ast.Node = self.param(in_class and first)
                first = False
                cur.next = pm
                cur = pm
                if self.consume(",") is None:
                    break
        self.expect_close(")", open_tok)
        return head.next

    # func_def ::= "def" IDENT "(" [ params ] ")" "->" type ":" block
    def func_def(mut self, in_class: bool) -> ast.Node:
        kw: token.Token = self.advance()   # "def"

        name_tok: token.Token = self.peek()
        if name_tok.kind != token.TK_IDENT:
            self.fail_hint(name_tok,
                           "def の後には関数名を書きます（例: def f() -> int:）",
                           "関数名が必要です")
        self.advance()

        n: ast.Node = ast.new_node(ast.ND_FUNC, kw)
        n.name = name_tok.text

        open_tok: token.Token = self.peek()
        if self.consume("(") is None:
            self.fail_hint(open_tok,
                           "関数名の後には引数リストが必要です" +
                           "（例: f() や f(n: int)）",
                           "'(' が必要です")

        n.params = self.param_list(open_tok, in_class)

        # メソッドの第 1 引数は self でなければならない（言語仕様 5.10）
        if in_class:
            p0: ast.Node | None = n.params
            msg: str = ("メソッド '" + n.name +
                        "' の第 1 引数は self でなければなりません")
            hint: str = ("Polonium は self を明示的に書きます" +
                         "（例: def show(self) -> None:）")
            if p0 is None:
                self.fail_full(name_tok, msg, "ここに self が必要です", hint)
            elif p0.name != "self":
                # ⚠️ 位置は「第 1 引数」（C 版と揃える）
                self.fail_full(self.tok_of(p0), msg, "ここに self が必要です", hint)

        # 戻り型は必須（言語仕様 3.3）
        if self.consume("->") is None:
            self.fail_hint(self.peek(),
                           "戻り型は省略できません。値を返さないなら -> None と書きます",
                           "'->' と戻り型が必要です")

        n.type_ref = self.type_ref("戻り型には型名を書きます（例: -> int / -> None）")

        # ── 第27章：raises 節（戻り型の後ろ）──
        if self.peek().is_kw("raises"):
            self.advance()
            rhead: ast.Node = ast.new_node(ast.ND_BLOCK, n.tok)   # 番兵
            rcur: ast.Node = rhead
            while True:
                rcur.next = self.raises_type()
                rnx: ast.Node | None = rcur.next
                if rnx is None:
                    panic("parser: unreachable")
                else:
                    rcur = rnx
                if self.consume("|") is None:
                    break
            n.err_types = rhead.next

        self.expect_colon("def の宣言")
        n.body = self.block()
        return n

    # raises に書けるのは「エラー型の名前」だけ（第27章）。
    #
    # ⚠️ type_ref は使えません。`raises A | B` の '|' を
    #    「T | None」の '|' と読んでしまうからです。
    def raises_type(mut self) -> ast.Node:
        t: token.Token = self.type_name_token(
            "raises にはエラーの型名を書きます（例: raises IOError）")
        n: ast.Node = ast.new_node(ast.ND_TYPEREF, t)
        n.name = t.text
        if self.peek().is_punct("."):
            self.advance()
            m: token.Token = self.type_name_token("モジュール修飾の後には型名を書きます")
            n.mod_name = n.name
            n.name = m.text
            n.tok = m
        return n

    # try_stmt ::= "try" ":" block { except_clause }
    # except_clause ::= "except" type [ "as" IDENT ] ":" block
    #
    # ★ 第27章：見た目は例外だが、実体は戻り値の検査（アンワインドしない）
    def try_stmt(mut self) -> ast.Node:
        kw: token.Token = self.advance()   # "try"
        self.expect_colon("try")

        n: ast.Node = ast.new_node(ast.ND_TRY, kw)
        n.body = self.block()

        head: ast.Node = ast.new_node(ast.ND_BLOCK, kw)   # 番兵
        cur: ast.Node = head
        while self.peek().is_kw("except"):
            ek: token.Token = self.advance()
            ex: ast.Node = ast.new_node(ast.ND_EXCEPT, ek)
            ex.type_ref = self.type_ref(
                "except には捕まえるエラーの型名を書きます（例: except IOError:）")
            if self.peek().is_kw("as"):
                self.advance()
                nm: token.Token = self.peek()
                if nm.kind != token.TK_IDENT:
                    self.fail_hint(nm,
                                   "as の後には変数名を書きます（例: except IOError as e:）",
                                   "変数名が必要です")
                self.advance()
                ex.name = nm.text
            self.expect_colon("except")
            ex.body = self.block()
            cur.next = ex
            cur = ex

        if head.next is None:
            self.fail_hint(self.peek(),
                           "try には except を 1 つ以上書きます（例: except IOError as e:）",
                           "この try には except がありません")
        n.els = head.next
        return n

    # field_decl ::= IDENT ":" type NEWLINE（初期化式は取らない）
    def field_decl(mut self) -> ast.Node:
        name_tok: token.Token = self.advance()   # IDENT
        self.advance()                           # ":"

        n: ast.Node = ast.new_node(ast.ND_FIELDDECL, name_tok)
        n.name = name_tok.text
        n.type_ref = self.type_ref("フィールドには型注釈が必須です（例: kind: int）")

        if self.peek().is_punct("="):
            self.fail_full(self.peek(), "フィールドに初期値は書けません",
                           "ここに '=' は書けません",
                           "初期値は init メソッドで代入してください" +
                           "（例: def init(self) -> None: / self.kind = 0）")
        self.expect_newline()
        return n

    # class_def ::= "class" IDENT ":" NEWLINE INDENT { field } { method } DEDENT
    def class_def(mut self) -> ast.Node:
        kw: token.Token = self.advance()   # "class"

        name_tok: token.Token = self.peek()
        if name_tok.kind != token.TK_IDENT:
            self.fail_hint(name_tok,
                           "class の後にはクラス名を書きます（例: class Token:）",
                           "クラス名が必要です")
        self.advance()

        n: ast.Node = ast.new_node(ast.ND_CLASS, kw)
        n.name = name_tok.text

        self.expect_colon("class の宣言")
        self.expect(token.TK_NEWLINE, "改行",
                    "':' の後は改行してクラス本体を字下げしてください")
        self.expect(token.TK_INDENT, "字下げされたクラス本体",
                    "クラスの中身は字下げして書きます（スペース 4 個を推奨）")

        head: ast.Node = ast.new_node(ast.ND_BLOCK, kw)
        cur: ast.Node = head
        first_method: ast.Node | None = None

        while (self.peek().kind != token.TK_DEDENT and
               self.peek().kind != token.TK_EOF):
            t: token.Token = self.peek()

            if t.is_kw("def"):
                m: ast.Node = self.func_def(True)   # ★ True = self を書ける
                cur.next = m
                cur = m
                if first_method is None:
                    first_method = m
                continue

            if t.kind == token.TK_IDENT and self.peek_at(1).is_punct(":"):
                # ⚠️ フィールドはメソッドより先（文法がそう決めている）
                if first_method is not None:
                    diag.error_full(t, "フィールドはメソッドより前に書いてください",
                                    "このフィールド宣言がメソッドより後ろにあります",
                                    self.tok_of(first_method),
                                    "最初のメソッドはここです",
                                    "クラス本体は「フィールドを全部 → メソッドを全部」" +
                                    "の順です（文法定義 3 節）")
                f: ast.Node = self.field_decl()
                cur.next = f
                cur = f
                continue

            self.fail_full(t, "クラスの中に書けるのはフィールドとメソッドだけです",
                           "ここには書けません",
                           "フィールドは「名前: 型」、メソッドは 'def' で始めます:\n" +
                           "             class Token:\n" +
                           "                 kind: int\n" +
                           "\n" +
                           "                 def show(self) -> None:\n" +
                           "                     print(self.kind)")
        self.expect(token.TK_DEDENT, "クラス本体の終わり", "")

        n.body = head.next
        return n

    # extern_def ::= "extern" "def" IDENT "(" [ params ] ")" "->" type NEWLINE
    #
    # ★ 新しいノード種別は作らない。body が None——「宣言はあるが定義がない」
    def extern_def(mut self) -> ast.Node:
        self.advance()   # "extern"

        if not self.peek().is_kw("def"):
            self.fail_hint(self.peek(),
                           "extern の後には def を書きます" +
                           "（例: extern def pl_system(cmd: str) -> int）",
                           "extern の後に def が必要です")
        self.advance()   # "def"

        name_tok: token.Token = self.peek()
        if name_tok.kind != token.TK_IDENT:
            self.fail_hint(name_tok, "extern def の後には C の関数名を書きます",
                           "関数名が必要です")
        self.advance()

        open_tok: token.Token = self.peek()
        if self.consume("(") is None:
            self.fail_hint(self.peek(), "引数リストを書いてください（例: (path: str)）",
                           "'(' が必要です")

        params: ast.Node | None = self.param_list(open_tok, False)

        if self.consume("->") is None:
            self.fail_hint(self.peek(), "戻り型を書いてください（例: -> int）",
                           "'->' が必要です")

        n: ast.Node = ast.new_node(ast.ND_FUNC, name_tok)
        n.name = name_tok.text
        n.params = params
        n.type_ref = self.type_ref("戻り型を書いてください（例: -> int）")

        # ⚠️ 本体は読まない
        if self.peek().is_punct(":"):
            self.fail_hint(self.peek(),
                           "extern 宣言は本体を持ちません（改行で終わります）",
                           "extern def に ':' は書けません")
        self.expect_newline()

        return n   # body は None のまま（★ extern の印）

    # import_stmt ::= "import" IDENT NEWLINE
    def import_stmt(mut self) -> ast.Node:
        kw: token.Token = self.advance()   # "import"

        name_tok: token.Token = self.peek()
        if name_tok.kind != token.TK_IDENT:
            self.fail_hint(name_tok,
                           "import の後にはモジュール名を書きます（例: import lexer）",
                           "モジュール名が必要です")
        self.advance()

        if self.peek().is_punct("."):
            self.fail_hint(self.peek(),
                           "モジュール名にドットは使えません" +
                           "（パッケージはありません）",
                           "'" + name_tok.text + "' の後に '.' は書けません")

        n: ast.Node = ast.new_node(ast.ND_IMPORT, kw)
        n.name = name_tok.text
        self.expect_newline()
        return n

    # program ::= { class_def | func_def | extern_def | import | global_var } EOF
    def program(mut self) -> ast.Node:
        head: ast.Node = ast.new_node(ast.ND_BLOCK, self.peek())
        cur: ast.Node = head
        first: token.Token = self.peek()

        while self.peek().kind != token.TK_EOF:
            t: token.Token = self.peek()

            if t.kind == token.TK_INDENT:
                self.fail_full(t, "予期しないインデントです",
                               "この行が余分に字下げされています",
                               "トップレベルに書けるのは def / class / import / " +
                               "extern とグローバル変数だけです（言語仕様 6.3）")
            if t.kind == token.TK_DEDENT:
                panic("parser: unexpected DEDENT")

            if t.is_kw("def"):
                d: ast.Node = self.func_def(False)
                cur.next = d
                cur = d
                continue

            if t.is_kw("class"):
                c: ast.Node = self.class_def()
                cur.next = c
                cur = c
                continue

            if t.is_kw("import"):
                im: ast.Node = self.import_stmt()
                cur.next = im
                cur = im
                continue

            if t.is_kw("extern"):
                ex: ast.Node = self.extern_def()
                cur.next = ex
                cur = ex
                continue

            # グローバル変数 ::= IDENT ":" type "=" expr NEWLINE
            if t.kind == token.TK_IDENT and self.peek_at(1).is_punct(":"):
                g: ast.Node = self.var_decl()
                cur.next = g
                cur = g
                self.expect_newline()
                continue

            self.fail_full(t, "トップレベルに実行文は書けません",
                           "ここに書けるのは def / class / import / extern と" +
                           "グローバル変数だけです",
                           "処理は main の中に書いてください:\n" +
                           "             def main() -> int:\n" +
                           "                 ...\n" +
                           "                 return 0")

        blk: ast.Node = ast.new_node(ast.ND_BLOCK, first)
        blk.body = head.next
        return blk


def parse(toks: list[token.Token]) -> ast.Node:
    p: Parser = Parser(toks)
    return p.program()
