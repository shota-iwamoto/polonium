# codegen.po — LLVM IR の生成（第19章）
#
# ★ src/codegen.c（1288 行）の移植です。**機械的に移しています。**
#   一時値・ラベルの連番、文字列リテラルの割り当て順、declare を出す順序まで
#   C 版と一致させます。1 つでもずれると diff に出ます。
#
# 生成規約は docs/design/ir-conventions.md にあります。
import strings
import ast
import langinfo
import module
import token
import types


# break / continue の飛び先（規約 6.5）
class LoopCtx:
    outer: LoopCtx | None
    break_label: str
    continue_label: str

    def init(self, outer: LoopCtx | None, break_label: str,
             continue_label: str) -> None:
        self.outer = outer
        self.break_label = copy(break_label)
        self.continue_label = copy(continue_label)


# 出力済みの文字列リテラル（同じ内容は 1 つにまとめる）
class StrLit:
    bytes_: str
    label: str
    next: StrLit | None

    def init(self, bytes_: str, label: str) -> None:
        self.bytes_ = copy(bytes_)
        self.label = copy(label)


class Emitter:
    # ── 出力バッファ（第1章で 4 本に分けた） ──
    header: list[str]   # source_filename, target triple, 型定義
    globals_: list[str] # グローバル変数・文字列定数
    decls: list[str]    # declare（外部関数宣言）
    body: list[str]     # 完成した関数定義

    # ── 生成中の関数用（関数ごとにリセット）──
    allocas: list[str]  # entry ブロックに置く alloca
    fn: list[str]       # 関数本体の命令列

    tmp_counter: int
    label_counter: int
    terminated: bool    # 現在の基本ブロックが終端済みか（規約 R6）

    loop: LoopCtx | None

    strs: StrLit | None      # 文字列リテラルの共有
    decled: list[str]        # declare の重複排除
    emitted_types: list[str]     # 型定義の重複排除（第13章）
    emitted_vtables: list[str]   # 第41章：vtable の重複排除
    str_counter: int

    triple: str

    # ── 第27章：エラー処理 ──
    fn_raises: bool          # 生成中の関数が raises を宣言しているか
    fn_ret: ast.Type | None  # 生成中の関数の戻り型（失敗時の既定値に使う）
    err_slot_done: bool      # この関数で %err.slot を alloca 済みか
    err_type_emitted: bool   # %pl.err の型定義を出したか
    prop_used: bool          # 伝播ブロックが使われたか
    try_stack: list[ast.Node]      # 今いる try（入れ子）
    try_labels: list[str]          # その振り分けラベル

    def init(self, triple: str) -> None:
        self.header = []
        self.globals_ = []
        self.decls = []
        self.body = []
        self.allocas = []
        self.fn = []
        self.tmp_counter = 0
        self.label_counter = 0
        self.terminated = False
        self.decled = []
        self.emitted_types = []
        self.emitted_vtables = []
        self.str_counter = 0
        self.triple = copy(triple)
        # ── 第27章 ──
        self.fn_raises = False
        self.err_slot_done = False
        self.err_type_emitted = False
        self.prop_used = False
        self.try_stack = []
        self.try_labels = []

    # プリミティブ型（型検査は終わっているので、ここでは「表現」だけ要る）
    def int_type(self) -> ast.Type:
        return ast.Type(ast.TY_INT)

    def bool_type(self) -> ast.Type:
        return ast.Type(ast.TY_BOOL)

    # ⚠️ 第17章：名前に '.' を入れる（利用者の変数と衝突しないため）
    def new_tmp(mut self) -> str:
        t: str = "%t." + str(self.tmp_counter)
        self.tmp_counter = self.tmp_counter + 1
        return t

    def emit(mut self, line: str) -> None:
        self.fn.append(copy(line))

    # ── 型のマッピング ──────────────────────────────────────

    # 値（レジスタ）としての LLVM 型
    def llvm_type(self, t: ast.Type) -> str:
        if t.kind == ast.TY_INT:
            return "i64"
        if t.kind == ast.TY_FLOAT:
            return "double"
        if t.kind == ast.TY_FN:
            return "ptr"          # 関数へのポインタ（第38章）
        if t.kind == ast.TY_IFACE:
            return "ptr"          # 実体へのポインタ（第41章）
        if t.kind == ast.TY_TUPLE:
            return "ptr"          # 構造体へのポインタ（第44章）
        if t.kind == ast.TY_BOOL:
            return "i1"
        if t.kind == ast.TY_NONE:
            return "void"
        if t.kind == ast.TY_STR:
            return "ptr"
        if t.kind == ast.TY_LIST:
            return "ptr"
        if t.kind == ast.TY_CLASS:
            return "ptr"
        if t.kind == ast.TY_OPT:
            return "ptr"
        if t.kind == ast.TY_RC:
            return "ptr"
        if t.kind == ast.TY_NULL:
            return "ptr"
        panic("codegen: 未知の型です")
        return "i64"

    # メモリ（alloca / load / store）としての LLVM 型
    # ⚠️ 規約 R5：bool はメモリ上 i8
    def llvm_mem_type(self, t: ast.Type) -> str:
        if t.kind == ast.TY_INT:
            return "i64"
        if t.kind == ast.TY_FLOAT:
            return "double"
        if t.kind == ast.TY_FN:
            return "ptr"          # 第38章
        if t.kind == ast.TY_IFACE:
            return "ptr"          # 第41章
        if t.kind == ast.TY_TUPLE:
            return "ptr"          # 第44章
        if t.kind == ast.TY_BOOL:
            return "i8"
        if t.kind == ast.TY_STR:
            return "ptr"
        if t.kind == ast.TY_LIST:
            return "ptr"
        if t.kind == ast.TY_CLASS:
            return "ptr"
        if t.kind == ast.TY_OPT:
            return "ptr"
        if t.kind == ast.TY_RC:
            return "ptr"
        panic("codegen: メモリ上の表現を持たない型です")
        return "i64"

    # 二項演算子に対応する LLVM 命令
    # ⚠️ int は符号付きなので 's' の付く命令を使う（sdiv / ashr）
    # ★ float は別命令（fadd など）。整数の add とはビット列の意味が違う。
    def llvm_binop_f(self, op: int) -> str:
        if op == ast.OP_ADD:
            return "fadd"
        if op == ast.OP_SUB:
            return "fsub"
        if op == ast.OP_MUL:
            return "fmul"
        if op == ast.OP_TRUEDIV:
            return "fdiv"
        panic("codegen: この演算子は float に来ません")
        return "fadd"

    # float の比較述語（ordered。NaN が絡むと必ず False）
    def fcmp_pred(self, op: int) -> str:
        if op == ast.OP_EQ:
            return "oeq"
        # ⚠️ '!=' だけ unordered（une）。a != b は「a == b ではない」なので、
        #    NaN が絡むと True でなければならない（x != x が NaN の判定）
        if op == ast.OP_NE:
            return "une"
        if op == ast.OP_LT:
            return "olt"
        if op == ast.OP_LE:
            return "ole"
        if op == ast.OP_GT:
            return "ogt"
        if op == ast.OP_GE:
            return "oge"
        panic("codegen: 比較演算子ではありません")
        return "oeq"

    def llvm_binop(self, op: int) -> str:
        if op == ast.OP_ADD:
            return "add"
        if op == ast.OP_SUB:
            return "sub"
        if op == ast.OP_MUL:
            return "mul"
        if op == ast.OP_BITAND:
            return "and"
        if op == ast.OP_BITOR:
            return "or"
        if op == ast.OP_BITXOR:
            return "xor"
        if op == ast.OP_SHL:
            return "shl"
        if op == ast.OP_SHR:
            return "ashr"
        panic("codegen: この演算子はここに来ません")
        return "add"

    # 比較演算子に対応する icmp の述語
    # ⚠️ i1 の符号付き比較は逆になるので、bool は符号なしを使う
    def icmp_pred(self, op: int, operand_type: ast.Type) -> str:
        sign: bool = operand_type.kind == ast.TY_INT
        if op == ast.OP_EQ:
            return "eq"
        if op == ast.OP_NE:
            return "ne"
        if op == ast.OP_LT:
            if sign:
                return "slt"
            return "ult"
        if op == ast.OP_LE:
            if sign:
                return "sle"
            return "ule"
        if op == ast.OP_GT:
            if sign:
                return "sgt"
            return "ugt"
        if op == ast.OP_GE:
            if sign:
                return "sge"
            return "uge"
        panic("codegen: 比較演算子ではありません")
        return "eq"

    # ── メモリとレジスタの境界（規約 R5）──────────────────
    #
    # ★ zext / trunc はこの 2 つの関数の中だけに閉じ込める

    def gen_load(mut self, ty: ast.Type, ptr: str) -> str:
        t: str = self.new_tmp()
        self.emit("  " + t + " = load " + self.llvm_mem_type(ty) + ", ptr " +
                  ptr + "\n")
        if ty.kind != ast.TY_BOOL:
            return t
        t2: str = self.new_tmp()
        self.emit("  " + t2 + " = trunc i8 " + t + " to i1\n")
        return t2

    def gen_store(mut self, ty: ast.Type, val: str, ptr: str) -> None:
        v: str = val
        if ty.kind == ast.TY_BOOL:
            t: str = self.new_tmp()
            self.emit("  " + t + " = zext i1 " + v + " to i8\n")
            v = t
        self.emit("  store " + self.llvm_mem_type(ty) + " " + v + ", ptr " +
                  ptr + "\n")

    # ── 基本ブロック（規約 R6 / R7）────────────────────────

    def emit_label(mut self, label: str) -> None:
        if not self.terminated:
            self.emit("  br label %" + label + "\n")
        self.emit(label + ":\n")
        self.terminated = False

    def emit_br(mut self, label: str) -> None:
        self.emit("  br label %" + label + "\n")
        self.terminated = True

    def emit_cond_br(mut self, cond: str, then_l: str, else_l: str) -> None:
        self.emit("  br i1 " + cond + ", label %" + then_l + ", label %" +
                  else_l + "\n")
        self.terminated = True

    # 終端済みのブロックの後ろにコードを置くときのラベル（規約 R7）
    def ensure_block(mut self) -> None:
        if not self.terminated:
            return
        l: str = "dead." + str(self.label_counter)
        self.label_counter = self.label_counter + 1
        self.emit_label(l)

    # ── 文字列リテラル（第9章）──────────────────────────────

    # IR の文字列に 1 バイト出力する
    # ⚠️ ASCII 印字可能文字以外はすべて \XX にする
    def emit_ir_byte(self, parts: mut list[str], c: int) -> None:
        if c >= 32 and c < 127 and c != 34 and c != 92:
            parts.append(chr(c))
        else:
            parts.append("\\" + hex2(c))

    def intern_str(mut self, bytes_: str) -> str:
        sl: StrLit | None = self.strs
        while sl is not None:
            s: StrLit = sl
            if s.bytes_ == bytes_:
                return s.label
            sl = s.next

        lab: str = "@.str." + str(self.str_counter)
        self.str_counter = self.str_counter + 1

        n: int = len(bytes_)
        parts: list[str] = []
        parts.append(lab + " = private unnamed_addr constant { i64, [" +
                     str(n + 1) + " x i8] } { i64 " + str(n) + ", [" +
                     str(n + 1) + " x i8] c\"")
        i: int = 0
        while i < n:
            self.emit_ir_byte(parts, strings.byte_at(bytes_, i))
            i = i + 1
        parts.append("\\00\" }\n")
        self.globals_.append(strings.join(parts, ""))

        # 値として使うのはデータ部のアドレス（定数式でそのまま書ける）
        ref: str = ("getelementptr inbounds ({ i64, [" + str(n + 1) +
                    " x i8] }, ptr " + lab + ", i32 0, i32 1)")

        lit: StrLit = StrLit(bytes_, ref)
        lit.next = self.strs
        self.strs = lit
        return ref

    # ランタイム関数を宣言する（1 回だけ）
    def declare_rt(mut self, sig: str) -> None:
        i: int = 0
        while i < len(self.decled):
            if self.decled[i] == sig:
                return
            i = i + 1
        self.decls.append("declare " + sig + "\n")
        self.decled.append(copy(sig))

    # 別モジュールの関数を declare する（引数の型は呼び出しから作る）
    def declare_extern(mut self, ret: str, ir_name: str, param_types: str) -> None:
        self.declare_rt(ret + " @" + ir_name + "(" + param_types + ")")

    # ── 式の生成 ────────────────────────────────────────────
    #
    # gen_expr の約束：
    #   「式を評価する命令列を fn に出力し、結果が入っている場所の名前を返す」
    #
    # ⚠️ 値を返さない式（void の呼び出し）は "" を返します。
    #   C 版は NULL を返しますが、Polonium では str の None を避けて空文字列に
    #   しました（**呼び出し側は結果を使わないと分かっている**場所だけです）。

    def gen_expr(mut self, n: ast.Node) -> str:
        if n.kind == ast.ND_INT:
            # 整数リテラルは命令を出す必要すらない（即値をそのまま書ける）
            return str(n.ival)

        if n.kind == ast.ND_FLOAT:
            # ★ 字句解析器が正規化した文字列を**そのまま**出す。
            #   double を経由しないので、C 版と 1 バイトもずれない。
            return n.sval

        if n.kind == ast.ND_COND:
            return self.gen_cond(n)

        if n.kind == ast.ND_SLICE:
            return self.gen_slice(n)

        if n.kind == ast.ND_TUPLE:
            return self.gen_tuple(n)

        if n.kind == ast.ND_BINOP:
            return self.gen_binop(n)

        if n.kind == ast.ND_BOOL:
            if n.ival != 0:
                return "true"
            return "false"

        if n.kind == ast.ND_NONE:
            # ★ 第15章：None は「null というポインタ即値」
            return "null"

        if n.kind == ast.ND_STR:
            return self.intern_str(n.sval)

        if n.kind == ast.ND_LOGICAL:
            return self.gen_logical(n)

        if n.kind == ast.ND_CALL:
            return self.gen_call(n)

        if n.kind == ast.ND_LIST:
            return self.gen_list_lit(n)

        if n.kind == ast.ND_INDEX:
            return self.gen_index(n)

        if n.kind == ast.ND_METHOD:
            return self.gen_method(n)

        if n.kind == ast.ND_FIELD:
            return self.gen_field(n)

        if n.kind == ast.ND_VAR:
            # ★ 第38章：関数の名前を値として使う場合。箱から読むのではなく、
            #   **関数のラベルそのもの**が値です。
            if n.is_func_ref:
                return "@" + n.ir_name
            # 変数の読み出し（規約 R2）。sema が割り当てた ir_name を使う
            return self.gen_load(type_of(n), n.ir_name)

        if n.kind == ast.ND_UNARY:
            return self.gen_unary(n)

        panic("codegen: 式ではないノードです")
        return ""

    # 三項演算子 a if c else b（第37章）
    #
    # ★ 作りは and / or の短絡評価と同じ。箱を 1 つ用意して、
    #   選ばれた側だけがそこに書く（規約 R3：phi を使わない）。
    def gen_cond(mut self, n: ast.Node) -> str:
        idn: int = self.label_counter
        self.label_counter = self.label_counter + 1
        sid: str = str(idn)
        then_l: str = "cond.then." + sid
        else_l: str = "cond.else." + sid
        end_l: str = "cond.end." + sid
        res: str = "%cond.result." + sid

        nt: ast.Type = type_of(n)
        self.allocas.append("  " + res + " = alloca " +
                            self.llvm_mem_type(nt) + "\n")

        c: str = self.gen_expr(node_of(n.lhs))
        self.emit_cond_br(c, then_l, else_l)

        self.emit_label(then_l)
        self.gen_store(nt, self.gen_expr(node_of(n.rhs)), res)
        self.emit_br(end_l)

        self.emit_label(else_l)
        self.gen_store(nt, self.gen_expr(node_of(n.els)), res)
        self.emit_br(end_l)

        self.emit_label(end_l)
        return self.gen_load(nt, res)

    # 探索関数に渡す形にする。⚠️ float は **double のまま**（数値として比べる）
    def elem_to_slot_cmp(mut self, elem: ast.Type, v: str) -> str:
        if elem.kind != ast.TY_BOOL:
            return v
        t: str = self.new_tmp()
        self.emit("  " + t + " = zext i1 " + v + " to i64\n")
        return t

    # 探索に使うランタイム関数の名前と引数型（in と index で共用）
    def index_fn(self, el: ast.Type) -> str:
        if el.kind == ast.TY_FLOAT:
            return "pl_list_index_f64"
        if el.kind == ast.TY_STR:
            return "pl_list_index_str"
        if self.elem_is_ptr(el):
            return "pl_list_index_ptr"
        return "pl_list_index_i64"

    def index_arg_ty(self, el: ast.Type) -> str:
        if el.kind == ast.TY_FLOAT:
            return "double"
        if el.kind == ast.TY_STR:
            return "ptr"
        if self.elem_is_ptr(el):
            return "ptr"
        return "i64"

    # x in xs / sub in s（第37章）
    #
    # ★ どちらも **位置を返すランタイム関数**（無ければ -1）に落として、
    #   その結果を 0 と比べるだけ。IR に分岐が 1 つも出ない（規約 R10）。
    def gen_in(mut self, n: ast.Node) -> str:
        lhs: ast.Node = node_of(n.lhs)
        rhs: ast.Node = node_of(n.rhs)
        rt: ast.Type = type_of(rhs)
        pos: str = self.new_tmp()

        if rt.kind == ast.TY_STR:
            self.declare_rt("i64 @pl_str_find(ptr, ptr)")
            hay: str = self.gen_expr(rhs)
            nee: str = self.gen_expr(lhs)
            self.emit("  " + pos + " = call i64 @pl_str_find(ptr " + hay +
                      ", ptr " + nee + ")\n")
        else:
            el: ast.Type = ast.elem_of(rt)
            fname: str = self.index_fn(el)
            aty: str = self.index_arg_ty(el)
            self.declare_rt("i64 @" + fname + "(ptr, " + aty + ")")
            lst: str = self.gen_expr(rhs)
            v: str = self.elem_to_slot_cmp(el, self.gen_expr(lhs))
            self.emit("  " + pos + " = call i64 @" + fname + "(ptr " + lst +
                      ", " + aty + " " + v + ")\n")

        pred: str = "slt"
        if n.op == ast.OP_IN:
            pred = "sge"
        t: str = self.new_tmp()
        self.emit("  " + t + " = icmp " + pred + " i64 " + pos + ", 0\n")
        return t

    # xs[a:b] / s[a:b]（第37章）
    #
    # ★ 省略された端は「先頭（0）」と「末尾（長さ）」に置き換えてから、
    #   ランタイムの 1 つの関数に渡す。範囲の丸めもランタイム側の仕事。
    # タプルの LLVM 型を作る（{i64, ptr} のような無名の構造体）
    #
    # ★ 名前を付けない。タプルは「並びが同じなら同じ型」なので、
    #   クラスのように定義を指す必要がないため。
    def tuple_ty(self, t: ast.Type) -> str:
        out: str = "{ "
        i: int = 0
        while i < len(t.params):
            if i > 0:
                out = out + ", "
            out = out + self.llvm_mem_type(t.params[i])
            i = i + 1
        return out + " }"

    # タプル式 (a, b)（第44章）
    #
    # ★ ヒープに確保して要素を書き込む。クラスと同じ扱いなので、
    #   list に入れる・引数で渡す・返す がすべてそのまま通る。
    def gen_tuple(mut self, n: ast.Node) -> str:
        t: ast.Type = type_of(n)
        size: int = 0
        si: int = 0
        while si < len(t.params):
            size = size + ast.type_size(t.params[si])
            si = si + 1

        self.declare_rt("ptr @pl_alloc(i64)")
        obj: str = self.new_tmp()
        self.emit("  " + obj + " = call ptr @pl_alloc(i64 " + str(size) + ")\n")

        ty: str = self.tuple_ty(t)
        k: int = 0
        xi: ast.Node | None = n.body
        while xi is not None:
            xn: ast.Node = xi
            v: str = self.gen_expr(xn)
            pt: str = self.new_tmp()
            self.emit("  " + pt + " = getelementptr " + ty + ", ptr " + obj +
                      ", i32 0, i32 " + str(k) + "\n")
            self.gen_store(t.params[k], v, pt)
            k = k + 1
            xi = xn.next
        return obj

    def gen_slice(mut self, n: ast.Node) -> str:
        lhs: ast.Node = node_of(n.lhs)
        is_str: bool = type_of(lhs).kind == ast.TY_STR
        obj: str = self.gen_expr(lhs)

        lo: str = "0"
        if n.rhs is not None:
            lo = self.gen_expr(node_of(n.rhs))

        hi: str = ""
        if n.els is not None:
            hi = self.gen_expr(node_of(n.els))
        else:
            lenfn: str = "pl_list_len"
            if is_str:
                lenfn = "pl_str_len"
            self.declare_rt("i64 @" + lenfn + "(ptr)")
            hi = self.new_tmp()
            self.emit("  " + hi + " = call i64 @" + lenfn + "(ptr " + obj + ")\n")

        slfn: str = "pl_list_slice"
        if is_str:
            slfn = "pl_str_slice"
        self.declare_rt("ptr @" + slfn + "(ptr, i64, i64)")
        t: str = self.new_tmp()
        self.emit("  " + t + " = call ptr @" + slfn + "(ptr " + obj + ", i64 " +
                  lo + ", i64 " + hi + ")\n")
        return t

    def gen_binop(mut self, n: ast.Node) -> str:
        # ★ 第37章：in / not in。⚠️ **左右をここで評価してはいけない**
        #   （渡す形が要素の型で変わるので gen_in の中で作る）
        if n.op == ast.OP_IN or n.op == ast.OP_NOTIN:
            return self.gen_in(n)

        lhs: ast.Node = node_of(n.lhs)
        rhs: ast.Node = node_of(n.rhs)

        # ★ 第15章：is / is not は「null と比べる」だけ。1 命令で済む
        if n.op == ast.OP_IS or n.op == ast.OP_ISNOT:
            v: str = self.gen_expr(lhs)
            t0: str = self.new_tmp()
            pred: str = "ne"
            if n.op == ast.OP_IS:
                pred = "eq"
            self.emit("  " + t0 + " = icmp " + pred + " ptr " + v + ", null\n")
            return t0

        # ★ 左辺 → 右辺の順に生成する（仕様 4.5）
        l: str = self.gen_expr(lhs)
        r: str = self.gen_expr(rhs)
        t: str = self.new_tmp()

        # ⚠️ オペランドの型は「結果の型」ではない（比較の結果は bool）
        ot: ast.Type = type_of(lhs)

        # ★ 第39章：繰り返しと list の連結（新しい値を作る）
        if n.op == ast.OP_MUL and ot.kind == ast.TY_STR:
            self.declare_rt("ptr @pl_str_repeat(ptr, i64)")
            self.emit("  " + t + " = call ptr @pl_str_repeat(ptr " + l +
                      ", i64 " + r + ")\n")
            return t
        if ot.kind == ast.TY_LIST and (n.op == ast.OP_ADD or n.op == ast.OP_MUL):
            if n.op == ast.OP_ADD:
                self.declare_rt("ptr @pl_list_concat(ptr, ptr)")
                self.emit("  " + t + " = call ptr @pl_list_concat(ptr " + l +
                          ", ptr " + r + ")\n")
            else:
                self.declare_rt("ptr @pl_list_repeat(ptr, i64)")
                self.emit("  " + t + " = call ptr @pl_list_repeat(ptr " + l +
                          ", i64 " + r + ")\n")
            return t

        # ── 文字列（第9章）──
        if ot.kind == ast.TY_STR:
            if n.op == ast.OP_ADD:
                self.declare_rt("ptr @pl_str_concat(ptr, ptr)")
                self.emit("  " + t + " = call ptr @pl_str_concat(ptr " + l +
                          ", ptr " + r + ")\n")
                return t
            # ⚠️ 比較は「内容」で行う（言語仕様 4.3）
            self.declare_rt("i64 @pl_str_cmp(ptr, ptr)")
            c: str = self.new_tmp()
            self.emit("  " + c + " = call i64 @pl_str_cmp(ptr " + l + ", ptr " +
                      r + ")\n")
            self.emit("  " + t + " = icmp " +
                      self.icmp_pred(n.op, self.int_type()) + " i64 " + c +
                      ", 0\n")
            return t

        # ★ 第44章：float の '**' はランタイムの pl_fpow に落とす。
        #   ⚠️ libc の pow は使えない（ベアメタルで動く必要があるため）。
        if n.op == ast.OP_POW and ot.kind == ast.TY_FLOAT:
            self.declare_rt("double @pl_fpow(double, double)")
            self.emit("  " + t + " = call double @pl_fpow(double " + l +
                      ", double " + r + ")\n")
            return t

        # ── 検査つきの算術（規約 R10。第9章）──
        if n.op == ast.OP_FLOORDIV or n.op == ast.OP_MOD or n.op == ast.OP_POW:
            fname: str = "pl_ipow"
            if n.op == ast.OP_FLOORDIV:
                fname = "pl_floordiv"
            elif n.op == ast.OP_MOD:
                fname = "pl_mod"
            self.declare_rt("i64 @" + fname + "(i64, i64)")
            self.emit("  " + t + " = call i64 @" + fname + "(i64 " + l +
                      ", i64 " + r + ")\n")
            return t

        # ★ float の比較は fcmp、算術は fadd などの別命令
        if ast.is_compare(n.op) and ot.kind == ast.TY_FLOAT:
            self.emit("  " + t + " = fcmp " + self.fcmp_pred(n.op) +
                      " double " + l + ", " + r + "\n")
        elif ast.is_compare(n.op):
            self.emit("  " + t + " = icmp " + self.icmp_pred(n.op, ot) + " " +
                      self.llvm_type(ot) + " " + l + ", " + r + "\n")
        elif ot.kind == ast.TY_FLOAT:
            self.emit("  " + t + " = " + self.llvm_binop_f(n.op) +
                      " double " + l + ", " + r + "\n")
        else:
            self.emit("  " + t + " = " + self.llvm_binop(n.op) + " " +
                      self.llvm_type(ot) + " " + l + ", " + r + "\n")
        return t

    def gen_unary(mut self, n: ast.Node) -> str:
        v: str = self.gen_expr(node_of(n.lhs))

        # +x は何もしない
        if n.op == ast.OP_POS:
            return v

        t: str = self.new_tmp()
        nt: ast.Type = type_of(n)
        if n.op == ast.OP_NEG and nt.kind == ast.TY_FLOAT:
            # ★ float には専用の否定命令 fneg がある（符号ビットの反転）
            self.emit("  " + t + " = fneg double " + v + "\n")
        elif n.op == ast.OP_NEG:
            # ⚠️ LLVM に整数の neg 命令は無い。0 からの減算で表す
            self.emit("  " + t + " = sub i64 0, " + v + "\n")
        elif n.op == ast.OP_BITNOT:
            self.emit("  " + t + " = xor i64 " + v + ", -1\n")
        elif n.op == ast.OP_NOT:
            self.emit("  " + t + " = xor i1 " + v + ", true\n")
        else:
            panic("codegen: 未知の単項演算子です")
        return t

    # ── 短絡評価（規約 6.6）────────────────────────────────
    #
    # 🤔 なぜ phi を使わないのか（規約 R3）
    #   alloca に置いて最後に読む方式なら「どのブロックから来たか」を
    #   覚えなくて済みます。mem2reg が phi に変換してくれます。
    def gen_logical(mut self, n: ast.Node) -> str:
        # ⚠️ 番号は最初に 1 回だけ確保する
        id_: int = self.label_counter
        self.label_counter = self.label_counter + 1

        kind: str = "or"
        if n.op == ast.OP_AND:
            kind = "and"

        rhs_l: str = kind + ".rhs." + str(id_)
        end_l: str = kind + ".end." + str(id_)
        res: str = "%" + kind + ".result." + str(id_)

        # 結果を入れる箱。★ alloca は entry ブロックへ（規約 R1）
        self.allocas.append("  " + res + " = alloca i8\n")

        # ① 左辺を評価し、その値をいったん結果として置く
        l: str = self.gen_expr(node_of(n.lhs))
        self.gen_store(self.bool_type(), l, res)

        # ② 右辺を評価すべきか分岐する（and と or で真偽が逆）
        if n.op == ast.OP_AND:
            self.emit_cond_br(l, rhs_l, end_l)
        else:
            self.emit_cond_br(l, end_l, rhs_l)

        # ③ 右辺（飛ばされることがあるブロック）
        self.emit_label(rhs_l)
        r: str = self.gen_expr(node_of(n.rhs))
        self.gen_store(self.bool_type(), r, res)
        self.emit_br(end_l)

        # ④ 合流点
        self.emit_label(end_l)
        return self.gen_load(self.bool_type(), res)

    # ── list[T]（第10章）────────────────────────────────────

    # ★ 第41章：インタフェースの値も「実体へのポインタ」1 個
    def elem_is_ptr(self, elem: ast.Type) -> bool:
        return (elem.kind == ast.TY_STR or elem.kind == ast.TY_LIST or
                elem.kind == ast.TY_CLASS or elem.kind == ast.TY_OPT or
                elem.kind == ast.TY_RC or elem.kind == ast.TY_NULL or
                elem.kind == ast.TY_IFACE or elem.kind == ast.TY_TUPLE)

    def slot_ty(self, elem: ast.Type) -> str:
        if self.elem_is_ptr(elem):
            return "ptr"
        return "i64"

    # 要素の値を「ランタイムに渡す形」にする（bool は i64 に広げる）
    # ★ float はビットパターンのまま i64 のスロットに入れる（list の作りを
    #   変えずに済む）。⚠️ 数値変換（sitofp）ではなく bitcast。
    def elem_to_slot(mut self, elem: ast.Type, v: str) -> str:
        if elem.kind == ast.TY_FLOAT:
            tf: str = self.new_tmp()
            self.emit("  " + tf + " = bitcast double " + v + " to i64\n")
            return tf
        if elem.kind != ast.TY_BOOL:
            return v
        t: str = self.new_tmp()
        self.emit("  " + t + " = zext i1 " + v + " to i64\n")
        return t

    def slot_to_elem(mut self, elem: ast.Type, v: str) -> str:
        if elem.kind == ast.TY_FLOAT:
            tf: str = self.new_tmp()
            self.emit("  " + tf + " = bitcast i64 " + v + " to double\n")
            return tf
        if elem.kind != ast.TY_BOOL:
            return v
        t: str = self.new_tmp()
        self.emit("  " + t + " = trunc i64 " + v + " to i1\n")
        return t

    # [1, 2, 3] は「空リストを作って append を繰り返す」に脱糖する
    def gen_list_lit(mut self, n: ast.Node) -> str:
        elem: ast.Type = ast.elem_of(type_of(n))

        self.declare_rt("ptr @pl_list_new()")
        l: str = self.new_tmp()
        self.emit("  " + l + " = call ptr @pl_list_new()\n")

        sty: str = self.slot_ty(elem)
        push: str = "pl_list_push_i64"
        if self.elem_is_ptr(elem):
            push = "pl_list_push_ptr"
        self.declare_rt("void @" + push + "(ptr, " + sty + ")")

        el: ast.Node | None = n.body
        while el is not None:
            e: ast.Node = el
            v: str = self.elem_to_slot(elem, self.gen_expr(e))
            self.emit("  call void @" + push + "(ptr " + l + ", " + sty + " " +
                      v + ")\n")
            el = e.next
        return l

    # None の検査を IR に展開する（第45章）。
    #
    # ⚠️ クラス型のフィールドは NULL から始まる（12.6 節）。
    #   NULL 参照を segfault ではなく親切なメッセージに変えるための検査。
    #
    # ★ もとは pl_check_not_none への**呼び出し 1 回**だった。
    #   フィールド参照はこの言語で最も回数の多い操作で、
    #   linalg.Matrix.get のような小さなメソッドでは 1 回の呼び出しに
    #   つき 2 回払っていた。ランタイムは別リンクなのでインライン化
    #   されない。検査ごと IR に出して呼び出しを無くす。
    #
    # ★ 検査は消えない。null なら pl_none_fail へ飛ぶ。
    def gen_not_none(mut self, obj: str) -> str:
        self.declare_rt("void @pl_none_fail() noreturn cold")

        id_: int = self.label_counter    # ★ 番号は最初に 1 回だけ確保する
        self.label_counter = self.label_counter + 1
        ok_l: str = "none.ok." + str(id_)
        bad_l: str = "none.bad." + str(id_)

        isn: str = self.new_tmp()
        self.emit("  " + isn + " = icmp eq ptr " + obj + ", null\n")
        self.emit_cond_br(isn, bad_l, ok_l)

        self.emit_label(bad_l)
        self.emit("  call void @pl_none_fail()\n")
        self.emit("  unreachable\n")
        self.terminated = True

        self.emit_label(ok_l)
        return obj

    # ── 添字を IR に展開する（第45章）──────────────────
    #
    # ⚠️ ここがこの言語の最大のボトルネックだった。
    #   xs[i] はもともと pl_list_len / pl_norm_index / pl_list_get_* の
    #   **関数呼び出し 3 回**だった。ランタイムは runtime.a として
    #   別にリンクされ、LTO を使っていないので -O2 でも
    #   インライン化されない。行列積の内側ループが呼び出し 5 回に
    #   なり、C の 61 倍遅くなっていた。
    #
    # ★ **検査は外さない**（方針 §0-②）。遅いのは検査ではなく
    #   呼び出しなので、検査ごと IR に出す。こうすると LLVM が
    #   ループの外へ持ち上げたり、範囲が自明なときに消したりできる。
    #
    # PlList の並びは { ptr data; i64 len; i64 cap }（runtime/core.c）。
    # data がオフセット 0、len が 8。
    #
    # ★ 範囲検査は **符号なしの比較 1 回**で済む。
    #   len >= 0 なので、i を符号なしとして見れば負の i は巨大な値に
    #   なり、i < 0 も i >= len も icmp ult ひとつで捕まる。
    #
    # normalize が True なら負の添字を末尾から数え直す（第39章）。
    # 戻り値は要素へのポインタ。
    def gen_index_addr(mut self, obj: str, idx0: str, sty: str,
                       normalize: bool) -> str:
        self.declare_rt("void @pl_index_fail(i64, i64) noreturn cold")

        lenp: str = self.new_tmp()
        self.emit("  " + lenp + " = getelementptr i8, ptr " + obj + ", i64 8\n")
        ln: str = self.new_tmp()
        self.emit("  " + ln + " = load i64, ptr " + lenp + "\n")

        idx: str = idx0
        if normalize:
            isneg: str = self.new_tmp()
            self.emit("  " + isneg + " = icmp slt i64 " + idx + ", 0\n")
            plus: str = self.new_tmp()
            self.emit("  " + plus + " = add i64 " + idx + ", " + ln + "\n")
            ni: str = self.new_tmp()
            self.emit("  " + ni + " = select i1 " + isneg + ", i64 " + plus +
                      ", i64 " + idx + "\n")
            idx = ni

        id_: int = self.label_counter    # ★ 番号は最初に 1 回だけ確保する
        self.label_counter = self.label_counter + 1
        ok_l: str = "idx.ok." + str(id_)
        bad_l: str = "idx.bad." + str(id_)

        inb: str = self.new_tmp()
        self.emit("  " + inb + " = icmp ult i64 " + idx + ", " + ln + "\n")
        self.emit_cond_br(inb, ok_l, bad_l)

        self.emit_label(bad_l)
        self.emit("  call void @pl_index_fail(i64 " + idx + ", i64 " + ln + ")\n")
        # ⚠️ pl_index_fail は戻ってこない。unreachable を置かないと
        #   LLVM は「戻るかも」と見て、検査をループ外へ出せなくなる。
        self.emit("  unreachable\n")
        self.terminated = True

        self.emit_label(ok_l)
        data: str = self.new_tmp()
        self.emit("  " + data + " = load ptr, ptr " + obj + "\n")
        ep: str = self.new_tmp()
        self.emit("  " + ep + " = getelementptr " + sty + ", ptr " + data +
                  ", i64 " + idx + "\n")
        return ep

    def gen_index(mut self, n: ast.Node) -> str:
        obj_node: ast.Node = node_of(n.lhs)
        ot: ast.Type = type_of(obj_node)
        obj: str = self.gen_expr(obj_node)
        idx0: str = self.gen_expr(node_of(n.rhs))

        # str の添字は 1 文字の str を返す。
        # ★ こちらは 1 文字の str を**新しく作る**ので、どのみち確保が
        #   入る。展開しても利かないので従来どおり呼び出す。
        if ot.kind == ast.TY_STR:
            self.declare_rt("i64 @pl_str_len(ptr)")
            self.declare_rt("i64 @pl_norm_index(i64, i64)")
            ln0: str = self.new_tmp()
            self.emit("  " + ln0 + " = call i64 @pl_str_len(ptr " + obj + ")\n")
            ni0: str = self.new_tmp()
            self.emit("  " + ni0 + " = call i64 @pl_norm_index(i64 " + idx0 +
                      ", i64 " + ln0 + ")\n")
            self.declare_rt("ptr @pl_str_index(ptr, i64)")
            t0: str = self.new_tmp()
            self.emit("  " + t0 + " = call ptr @pl_str_index(ptr " + obj +
                      ", i64 " + ni0 + ")\n")
            return t0

        elem: ast.Type = ast.elem_of(ot)
        sty: str = self.slot_ty(elem)
        ep: str = self.gen_index_addr(obj, idx0, sty, True)
        t: str = self.new_tmp()
        self.emit("  " + t + " = load " + sty + ", ptr " + ep + "\n")
        return self.slot_to_elem(elem, t)

    def gen_index_store(mut self, target: ast.Node, val: str) -> None:
        obj_node: ast.Node = node_of(target.lhs)
        elem: ast.Type = ast.elem_of(type_of(obj_node))
        obj: str = self.gen_expr(obj_node)
        idx: str = self.gen_expr(node_of(target.rhs))

        sty: str = self.slot_ty(elem)
        # ⚠️ 代入側は負の添字を正規化しない。
        #   pl_list_set_* を呼んでいたころからそうだった（xs[-1] = v は panic）。
        #   ここで変えると意味が変わるので、振る舞いはそのままにする。
        ep: str = self.gen_index_addr(obj, idx, sty, False)
        v: str = self.elem_to_slot(elem, val)
        self.emit("  store " + sty + " " + v + ", ptr " + ep + "\n")

    # ── 呼び出し ────────────────────────────────────────────

    # 引数を評価して "型 値, 型 値" と "型, 型"（declare 用）を作る
    def gen_args(mut self, args: ast.Node | None, vals: mut list[str], atypes: mut list[str],
                 first: bool) -> None:
        is_first: bool = first
        a: ast.Node | None = args
        while a is not None:
            arg: ast.Node = a
            v: str = self.gen_expr(arg)
            sep: str = ", "
            if is_first:
                sep = ""
            vals.append(sep + self.llvm_type(type_of(arg)) + " " + v)
            atypes.append(sep + self.llvm_type(type_of(arg)))
            is_first = False
            a = arg.next

    # 呼び出しを 1 行出す（戻り値が None なら値を返さない）
    def emit_call(mut self, n: ast.Node, args: str) -> str:
        rt: ast.Type = type_of(n)

        # ── 第27章：失敗しうる呼び出し ──
        #   ① タグを 0 にする ② スロットを渡す ③ 戻ってタグを見る
        full: str = args
        slot: str = ""
        if n.can_fail:
            slot = self.err_slot()
            tp: str = self.new_tmp()
            self.emit("  " + tp + " = getelementptr %pl.err, ptr " + slot +
                      ", i32 0, i32 0\n")
            self.emit("  store i64 0, ptr " + tp + "\n")
            if len(args) > 0:
                full = args + ", ptr " + slot
            else:
                full = "ptr " + slot

        t: str = ""
        if rt.kind == ast.TY_NONE:
            self.emit("  call void @" + n.ir_name + "(" + full + ")\n")
        else:
            t = self.new_tmp()
            self.emit("  " + t + " = call " + self.llvm_type(rt) + " @" +
                      n.ir_name + "(" + full + ")\n")

        if n.can_fail:
            cid: int = self.label_counter
            self.label_counter = self.label_counter + 1
            ok_l: str = "call.ok." + str(cid)
            tag: str = self.load_tag(slot)
            bad: str = self.new_tmp()
            self.emit("  " + bad + " = icmp ne i64 " + tag + ", 0\n")
            fl: str = self.fail_label()
            if len(fl) > 0:
                self.emit_cond_br(bad, fl, ok_l)
            else:
                # 到達しない経路（sema が保証）。専用ブロックに落とす
                un_l: str = "call.unreach." + str(cid)
                self.emit_cond_br(bad, un_l, ok_l)
                self.emit_label(un_l)
                self.emit("  unreachable\n")
                self.terminated = True
            self.emit_label(ok_l)
        return t

    def gen_method(mut self, n: ast.Node) -> str:
        # ★ 第13章：'.' の左がモジュールだった場合
        if len(n.mod_name) > 0:
            if n.cls is not None:
                return self.gen_new(n)      # lexer.Token(1, "x")

            vals: list[str] = []
            atypes: list[str] = []
            self.gen_args(n.args, vals, atypes, True)
            if n.is_extern:
                ats0: str = strings.join(atypes, "")
                if n.can_fail:
                    if len(ats0) > 0:
                        ats0 = ats0 + ", ptr"
                    else:
                        ats0 = "ptr"
                self.declare_extern(self.llvm_type(type_of(n)), n.ir_name, ats0)
            return self.emit_call(n, strings.join(vals, ""))

        obj_node: ast.Node = node_of(n.lhs)
        ot: ast.Type = type_of(obj_node)

        # ★ 第41章：インタフェース越しの呼び出し。
        #   ① 実体の先頭から vtable を読む ② スロットの関数ポインタを読む ③ 呼ぶ
        #   ⚠️ 呼び先はコンパイル時には決まらない（実行時の型で決まる）。
        if n.is_iface_call:
            iobj: str = self.gen_expr(obj_node)
            iok: str = self.gen_not_none(iobj)
            ivt: str = self.new_tmp()
            self.emit("  " + ivt + " = load ptr, ptr " + iok + "\n")
            islotp: str = self.new_tmp()
            self.emit("  " + islotp + " = getelementptr [" +
                      str(ast.iface_slots()) + " x ptr], ptr " + ivt +
                      ", i32 0, i32 " + str(n.iface_slot) + "\n")
            ifp: str = self.new_tmp()
            self.emit("  " + ifp + " = load ptr, ptr " + islotp + "\n")

            iargs2: list[str] = []
            itypes2: list[str] = []
            iargs2.append("ptr " + iok)
            self.gen_args(n.args, iargs2, itypes2, False)
            ia2: str = strings.join(iargs2, "")
            if type_of(n).kind == ast.TY_NONE:
                self.emit("  call void " + ifp + "(" + ia2 + ")\n")
                return ""
            it2: str = self.new_tmp()
            self.emit("  " + it2 + " = call " + self.llvm_type(type_of(n)) +
                      " " + ifp + "(" + ia2 + ")\n")
            return it2

        # クラスのメソッド（第12章）。self を第 1 引数に渡すだけ
        # ★ 第28章：rc[T] の中身のメソッドも同じように呼べる
        if ot.kind == ast.TY_CLASS or ot.kind == ast.TY_RC:
            obj: str = self.deref_rc(ot, self.gen_expr(obj_node))

            vals2: list[str] = []
            atypes2: list[str] = []
            vals2.append("ptr " + obj)
            atypes2.append("ptr")
            self.gen_args(n.args, vals2, atypes2, False)

            # ★ 第13章：import したクラスのメソッドは declare が要る
            if n.is_extern:
                ats2: str = strings.join(atypes2, "")
                if n.can_fail:
                    ats2 = ats2 + ", ptr"
                self.declare_extern(self.llvm_type(type_of(n)), n.ir_name, ats2)
            return self.emit_call(n, strings.join(vals2, ""))

        # ── list のメソッド（第10章 append／第37章でその他）──
        #
        # ★ ランタイム側は **すべて i64 のスロット**で扱う。list の中身が
        #   「ポインタ 1 個か i64 1 個」という第10章の作りのままなので、
        #   pop / insert / remove は 1 つの関数で全部の要素型に効く。
        elem: ast.Type = ast.elem_of(ot)
        obj2: str = self.gen_expr(obj_node)

        if n.name == "pop" or n.name == "remove":
            t1: str = self.new_tmp()
            if n.name == "pop":
                self.declare_rt("i64 @pl_list_pop(ptr)")
                self.emit("  " + t1 + " = call i64 @pl_list_pop(ptr " + obj2 +
                          ")\n")
            else:
                self.declare_rt("i64 @pl_list_remove_at(ptr, i64)")
                iv0: str = self.gen_expr(node_of(n.args))
                self.emit("  " + t1 +
                          " = call i64 @pl_list_remove_at(ptr " + obj2 +
                          ", i64 " + iv0 + ")\n")
            if self.elem_is_ptr(elem):
                pt: str = self.new_tmp()
                self.emit("  " + pt + " = inttoptr i64 " + t1 + " to ptr\n")
                return pt
            return self.slot_to_elem(elem, t1)

        if n.name == "insert":
            self.declare_rt("void @pl_list_insert(ptr, i64, i64)")
            ipos: str = self.gen_expr(node_of(n.args))
            v2: str = self.elem_to_slot(elem,
                                        self.gen_expr(node_of(
                                            node_of(n.args).next)))
            iv2: str = v2
            if self.elem_is_ptr(elem):
                iv2 = self.new_tmp()
                self.emit("  " + iv2 + " = ptrtoint ptr " + v2 + " to i64\n")
            self.emit("  call void @pl_list_insert(ptr " + obj2 + ", i64 " +
                      ipos + ", i64 " + iv2 + ")\n")
            return ""

        if n.name == "index":
            fname: str = self.index_fn(elem)
            aty: str = self.index_arg_ty(elem)
            self.declare_rt("i64 @" + fname + "(ptr, " + aty + ")")
            v3: str = self.elem_to_slot_cmp(elem, self.gen_expr(node_of(n.args)))
            t3: str = self.new_tmp()
            self.emit("  " + t3 + " = call i64 @" + fname + "(ptr " + obj2 +
                      ", " + aty + " " + v3 + ")\n")
            return t3

        if n.name == "reverse":
            self.declare_rt("void @pl_list_reverse(ptr)")
            self.emit("  call void @pl_list_reverse(ptr " + obj2 + ")\n")
            return ""
        if n.name == "clear":
            self.declare_rt("void @pl_list_clear(ptr)")
            self.emit("  call void @pl_list_clear(ptr " + obj2 + ")\n")
            return ""
        if n.name == "copy":
            self.declare_rt("ptr @pl_list_copy(ptr)")
            t4: str = self.new_tmp()
            self.emit("  " + t4 + " = call ptr @pl_list_copy(ptr " + obj2 +
                      ")\n")
            return t4
        if n.name == "extend":
            self.declare_rt("void @pl_list_extend(ptr, ptr)")
            o2: str = self.gen_expr(node_of(n.args))
            self.emit("  call void @pl_list_extend(ptr " + obj2 + ", ptr " +
                      o2 + ")\n")
            return ""

        sty: str = self.slot_ty(elem)
        push: str = "pl_list_push_i64"
        if self.elem_is_ptr(elem):
            push = "pl_list_push_ptr"
        self.declare_rt("void @" + push + "(ptr, " + sty + ")")

        v: str = self.elem_to_slot(elem, self.gen_expr(node_of(n.args)))
        self.emit("  call void @" + push + "(ptr " + obj2 + ", " + sty + " " +
                  v + ")\n")
        return ""

    # ── class の生成（第12章）──────────────────────────────

    # フィールドのアドレスを求める（読み出しにも代入にも使う）
    def gen_field_ptr(mut self, n: ast.Node) -> str:
        obj_node: ast.Node = node_of(n.lhs)
        ot0: ast.Type = type_of(obj_node)
        # ★ 第28章：rc[T] は中身のように使える
        cty: ast.Type = ot0
        if ot0.kind == ast.TY_RC:
            cty = ast.elem_of(ot0)
        c: ast.Class = class_of(cty.cls)
        obj: str = self.deref_rc(ot0, self.gen_expr(obj_node))

        # ⚠️ クラス型のフィールドは NULL から始まる（12.6 節）
        # ★ 第45章：検査を IR に展開する（規約 R10 の例外。理由は gen_not_none）
        ok: str = self.gen_not_none(obj)

        # ⚠️ 第 1 インデックスは常に 0（「Token の配列の何個目か」）
        t: str = self.new_tmp()
        self.emit("  " + t + " = getelementptr %" + self.class_type(c) +
                  ".type, ptr " + ok + ", i32 0, i32 " +
                  str(field_of(n.field).index) + "\n")
        return t

    # 他モジュールのグローバル変数は external で宣言する
    def declare_extern_global(mut self, n: ast.Node) -> None:
        sig: str = (n.ir_name + " = external global " +
                    self.llvm_mem_type(type_of(n)))
        i: int = 0
        while i < len(self.decled):
            if self.decled[i] == sig:
                return
            i = i + 1
        self.globals_.append(sig + "\n")
        self.decled.append(sig)

    def gen_field(mut self, n: ast.Node) -> str:
        # ★ 第38章：math.sin のように他モジュールの関数を値として使う場合。
        #   ⚠️ 呼ぶわけではないので **declare だけ**出して、ラベルを値にする。
        if n.is_func_ref:
            ftt: ast.Type = type_of(n)
            ps: list[str] = []
            for pt in ftt.params:
                ps.append(self.llvm_type(pt))
            self.declare_extern(self.llvm_type(ast.elem_of(ftt)), n.ir_name,
                                strings.join(ps, ", "))
            return "@" + n.ir_name

        # ★ 第13章：'.' の左がモジュールなら、グローバル変数の読み出し
        if len(n.mod_name) > 0:
            if n.is_extern:
                self.declare_extern_global(n)
            return self.gen_load(type_of(n), n.ir_name)

        return self.gen_load(type_of(n), self.gen_field_ptr(n))

    # インスタンス生成 Token(1, "x")
    # ── 第41章：vtable ──────────────────────────────────────
    #
    # ★ クラス 1 つにつき **1 本**の表を出す。中身は「プログラム全体の
    #   インタフェース・メソッドのスロット数」ぶんの関数ポインタの配列で、
    #   そのクラスが実装しているスロットだけが埋まり、残りは null。
    #
    # 🤔 なぜスロットを全体で一意にするのか
    #   1 つのクラスが複数のインタフェースを実装できるようにするため。
    #   インタフェースごとに 0 から振ると、呼ぶ側（インタフェースしか
    #   知らない）がどの表のどこを見ればよいか決められない。
    #   ⚠️ 代わりに表は疎になる。
    def gen_vtable(mut self, c: ast.Class) -> None:
        if len(c.impls) == 0:
            return
        vi: int = 0
        while vi < len(self.emitted_vtables):
            if self.emitted_vtables[vi] == c.ir_name:
                return
            vi = vi + 1
        self.emitted_vtables.append(c.ir_name)

        n2: int = ast.iface_slots()
        parts: list[str] = []
        parts.append("@vt." + c.ir_name + " = private constant [" + str(n2) +
                     " x ptr] [")
        i: int = 0
        while i < n2:
            fn: str = ""
            for l in c.impls:
                for im in l.methods:
                    if im.slot == i:
                        fn = c.ir_name + "." + im.name
            sep: str = ", "
            if i == 0:
                sep = ""
            if len(fn) > 0:
                parts.append(sep + "ptr @" + fn)
            else:
                parts.append(sep + "ptr null")
            i = i + 1
        parts.append("]\n")
        self.globals_.append(strings.join(parts, ""))

    def gen_new(mut self, n: ast.Node) -> str:
        c: ast.Class = class_of(n.cls)

        self.declare_rt("ptr @pl_alloc(i64)")
        obj: str = self.new_tmp()
        self.emit("  " + obj + " = call ptr @pl_alloc(i64 " + str(c.size) + ")\n")

        # ★ 第41章：インタフェースを実装するなら、先頭に vtable を入れる。
        #   ⚠️ ここを忘れると、インタフェース越しの呼び出しが null を呼ぶ。
        if len(c.impls) > 0:
            self.gen_vtable(c)
            vp: str = self.new_tmp()
            self.emit("  " + vp + " = getelementptr %" + c.ir_name +
                      ".type, ptr " + obj + ", i32 0, i32 0\n")
            self.emit("  store ptr @vt." + c.ir_name + ", ptr " + vp + "\n")

        # ★ ゼロ初期化では足りない型に、有効な値を入れておく（12.6 節）
        f: ast.Field | None = c.fields
        while f is not None:
            fld: ast.Field = f
            ft: ast.Type = type_of_field(fld)
            if ft.kind == ast.TY_STR or ft.kind == ast.TY_LIST:
                val: str = ""
                if ft.kind == ast.TY_STR:
                    val = self.intern_str("")
                else:
                    self.declare_rt("ptr @pl_list_new()")
                    val = self.new_tmp()
                    self.emit("  " + val + " = call ptr @pl_list_new()\n")
                p: str = self.new_tmp()
                self.emit("  " + p + " = getelementptr %" + self.class_type(c) +
                          ".type, ptr " + obj + ", i32 0, i32 " +
                          str(fld.index) + "\n")
                self.emit("  store ptr " + val + ", ptr " + p + "\n")
            f = fld.next

        if not c.has_init:
            return obj

        # init は「self を第 1 引数に取るふつうの関数」
        vals: list[str] = []
        atypes: list[str] = []
        vals.append("ptr " + obj)
        atypes.append("ptr")
        self.gen_args(n.args, vals, atypes, False)

        init_name: str = c.ir_name + ".init"

        # ★ 第13章：別モジュールのクラスなら declare が要る
        if n.is_extern:
            self.declare_extern("void", init_name, strings.join(atypes, ""))

        self.emit("  call void @" + init_name + "(" + strings.join(vals, "") +
                  ")\n")
        return obj

    # クラスの型定義を出す：%lexer.Token.type = type { i64, ptr }
    #
    # ⚠️ LLVM の型定義はモジュールローカル。import したクラスを使う
    #   モジュールにも、同じ定義を書き直す必要があります（13.7 節）。
    def gen_class_type(mut self, c: ast.Class) -> None:
        i: int = 0
        while i < len(self.emitted_types):
            if self.emitted_types[i] == c.ir_name:
                return
            i = i + 1
        self.emitted_types.append(c.ir_name)

        parts: list[str] = []
        parts.append("%" + c.ir_name + ".type = type { ")
        first: bool = True
        # ★ 第41章：インタフェースを実装するなら、先頭に vtable へのポインタ。
        #   ⚠️ sema の layout_class と **並びを揃えること**（ずれると全部壊れる）。
        if len(c.impls) > 0:
            parts.append("ptr")
            first = False
        f: ast.Field | None = c.fields
        while f is not None:
            fld: ast.Field = f
            sep: str = ", "
            if first:
                sep = ""
            parts.append(sep + self.llvm_mem_type(type_of_field(fld)))
            first = False
            f = fld.next
        parts.append(" }\n")
        self.header.append(strings.join(parts, ""))

    # クラスの型名を返す（まだ出していなければ定義も出す）
    def class_type(mut self, c: ast.Class) -> str:
        self.gen_class_type(c)
        return c.ir_name

    # ── 制御構文（規約 6.3 / 6.4 / 6.5）────────────────────

    def gen_if(mut self, n: ast.Node) -> None:
        id_: int = self.label_counter    # ★ 番号は最初に 1 回だけ確保する
        self.label_counter = self.label_counter + 1

        then_l: str = "if.then." + str(id_)
        else_l: str = "if.else." + str(id_)
        end_l: str = "if.end." + str(id_)

        cond: str = self.gen_expr(node_of(n.lhs))
        # else が無ければ else ブロックを作らず、直接 end へ分岐する
        target: str = end_l
        if n.els is not None:
            target = else_l
        self.emit_cond_br(cond, then_l, target)

        self.emit_label(then_l)
        self.gen_stmt(node_of(n.body))
        # ⚠️ then 節が break / continue で終わっていたら既に終端済み
        if not self.terminated:
            self.emit_br(end_l)

        if n.els is not None:
            self.emit_label(else_l)
            self.gen_stmt(node_of(n.els))
            if not self.terminated:
                self.emit_br(end_l)

        self.emit_label(end_l)

    def gen_while(mut self, n: ast.Node) -> None:
        id_: int = self.label_counter
        self.label_counter = self.label_counter + 1

        cond_l: str = "while.cond." + str(id_)
        body_l: str = "while.body." + str(id_)
        end_l: str = "while.end." + str(id_)

        # ⚠️ 条件ブロックに「入る」ための br が必要（規約 6.4）
        self.emit_br(cond_l)

        self.emit_label(cond_l)
        cond: str = self.gen_expr(node_of(n.lhs))   # ★ 条件は毎回評価される
        self.emit_cond_br(cond, body_l, end_l)

        # ★ 第11章：増分があるなら continue の飛び先は「増分ブロック」
        cont_l: str = cond_l
        incr_l: str = "for.incr." + str(id_)
        if n.incr is not None:
            cont_l = incr_l

        # break / continue の飛び先を積む
        ctx: LoopCtx = LoopCtx(self.loop, end_l, cont_l)
        self.loop = ctx

        self.emit_label(body_l)
        self.gen_stmt(node_of(n.body))

        if n.incr is not None:
            # ★ emit_label が br を補うので、本体から増分へは自動で繋がる
            self.emit_label(incr_l)
            self.gen_stmt(node_of(n.incr))
        if not self.terminated:
            self.emit_br(cond_l)      # ループバック

        self.loop = ctx.outer         # ★ 対で戻す

        self.emit_label(end_l)

    # ── 組み込み関数の呼び出し（第9章）────────────────────

    def gen_builtin_call(mut self, n: ast.Node) -> str:
        arg_node: ast.Node = node_of(n.args)
        at: ast.Type = type_of(arg_node)
        rt: ast.Type = type_of(n)

        # ⚠️ bool は C 側で long long で受け取るので、境界で i64 に広げる
        argty: str = self.llvm_type(at)
        if at.kind == ast.TY_BOOL:
            argty = "i64"

        # ★ 第46章：**cold** も付ける。noreturn は「戻らない」ことしか言わず、
        #   インライン化の見積りには効かない。panic の手前に並ぶ
        #   メッセージ組み立て（連結・数値→文字列）が呼び出し 6 回ぶんの
        #   費用として数えられ、それを含む小さな検査メソッドが
        #   **丸ごとインライン化を諦められて**いた。
        #   cold を付けると、その経路は「まず通らない」ものとして扱われる。
        #
        # ★ 第45章：**戻らない**組み込み（panic / exit）には noreturn を付ける。
        #   付けないと LLVM は「戻ってくるかもしれない」と見なし、
        #     ① panic の後ろの経路を生かしたままにする
        #     ② panic までに並ぶ文字列連結を「メモリを書くかもしれない呼び出し」
        #        として扱い、**ループ内の load を外に持ち上げられなくなる**
        #   の 2 つが起きる。
        #   ⚠️ ②「linalg.Matrix.check の self.rows / self.cols / self.data が
        #     ループ外に出せない」と第45章では書いていたが、**間違いだった**。
        #     測ったところ、あの遅さの原因はインライン化のほう（上の第46章）。
        #   ⚠️ sema の never_returns_call と対になっている。片方だけ変えないこと。
        nr: str = ""
        if n.builtin == "pl_panic" or n.builtin == "pl_exit":
            nr = " noreturn cold"
        self.declare_rt(self.llvm_type(rt) + " @" + n.builtin + "(" + argty + ")" + nr)

        v: str = self.gen_expr(arg_node)
        if at.kind == ast.TY_BOOL:
            z: str = self.new_tmp()
            self.emit("  " + z + " = zext i1 " + v + " to i64\n")
            v = z

        if rt.kind == ast.TY_NONE:
            self.emit("  call void @" + n.builtin + "(" + argty + " " + v + ")\n")
            return ""
        t: str = self.new_tmp()
        self.emit("  " + t + " = call " + self.llvm_type(rt) + " @" + n.builtin +
                  "(" + argty + " " + v + ")\n")
        return t

    # ── エラー処理の道具（第27章）──────────────────────────
    #
    # ★ 失敗しうる関数は、末尾に「エラー出力ポインタ」を 1 本余分に取ります。
    #   %pl.err = type { i64, ptr }  … { タグ, エラーオブジェクト }
    #   タグ 0 は「エラー無し」に予約。

    def ensure_err_type(mut self) -> None:
        if self.err_type_emitted:
            return
        self.err_type_emitted = True
        self.header.append("%pl.err = type { i64, ptr }\n")

    def err_slot(mut self) -> str:
        self.ensure_err_type()
        if not self.err_slot_done:
            self.err_slot_done = True
            self.allocas.append("  %err.slot = alloca %pl.err\n")
        return "%err.slot"

    # 型ごとの「使われない戻り値」（設計 §2 の表）。void なら空文字
    def default_value(self, t: ast.Type) -> str:
        if t.kind == ast.TY_NONE:
            return ""
        if t.kind == ast.TY_INT:
            return "0"
        if t.kind == ast.TY_BOOL:
            return "false"
        return "null"

    def emit_default_ret(mut self) -> None:
        rt: ast.Type = type_or_none(self.fn_ret)
        dv: str = self.default_value(rt)
        if len(dv) == 0:
            self.emit("  ret void\n")
        else:
            self.emit("  ret " + self.llvm_type(rt) + " " + dv + "\n")
        self.terminated = True

    # 失敗したときの飛び先。無ければ空文字（到達しない）
    def fail_label(mut self) -> str:
        if len(self.try_labels) > 0:
            return self.try_labels[len(self.try_labels) - 1]
        if not self.fn_raises:
            return ""
        self.prop_used = True
        return "err.propagate"

    def emit_fail_br(mut self) -> None:
        l: str = self.fail_label()
        if len(l) > 0:
            self.emit_br(l)
        else:
            self.emit("  unreachable\n")
            self.terminated = True

    def store_err(mut self, slot: str, tag: int, obj: str) -> None:
        self.ensure_err_type()
        tp: str = self.new_tmp()
        self.emit("  " + tp + " = getelementptr %pl.err, ptr " + slot +
                  ", i32 0, i32 0\n")
        self.emit("  store i64 " + str(tag) + ", ptr " + tp + "\n")
        pp: str = self.new_tmp()
        self.emit("  " + pp + " = getelementptr %pl.err, ptr " + slot +
                  ", i32 0, i32 1\n")
        self.emit("  store ptr " + obj + ", ptr " + pp + "\n")

    def load_tag(mut self, slot: str) -> str:
        tp: str = self.new_tmp()
        self.emit("  " + tp + " = getelementptr %pl.err, ptr " + slot +
                  ", i32 0, i32 0\n")
        tv: str = self.new_tmp()
        self.emit("  " + tv + " = load i64, ptr " + tp + "\n")
        return tv

    def load_payload(mut self, slot: str) -> str:
        pp: str = self.new_tmp()
        self.emit("  " + pp + " = getelementptr %pl.err, ptr " + slot +
                  ", i32 0, i32 1\n")
        pv: str = self.new_tmp()
        self.emit("  " + pv + " = load ptr, ptr " + pp + "\n")
        return pv

    # rc[T] なら中身を取り出す（第28章の自動デリファレンス）
    def deref_rc(mut self, t: ast.Type, v: str) -> str:
        if t.kind != ast.TY_RC:
            return v
        self.declare_rt("ptr @pl_rc_get(ptr)")
        g: str = self.new_tmp()
        self.emit("  " + g + " = call ptr @pl_rc_get(ptr " + v + ")\n")
        return g

    def gen_call(mut self, n: ast.Node) -> str:
        # ★ 第39章：min / max。**分岐を作らず select 1 命令**で済ませる
        if n.is_minmax:
            ma: str = self.gen_expr(node_of(n.args))
            mb: str = self.gen_expr(node_of(node_of(n.args).next))
            nt2: ast.Type = type_of(n)
            isf: bool = nt2.kind == ast.TY_FLOAT
            pr: str = "sgt"
            if n.name == "min":
                pr = "slt"
            if isf:
                pr = "ogt"
                if n.name == "min":
                    pr = "olt"
            mc: str = self.new_tmp()
            cmpop: str = "icmp"
            if isf:
                cmpop = "fcmp"
            self.emit("  " + mc + " = " + cmpop + " " + pr + " " +
                      self.llvm_type(nt2) + " " + ma + ", " + mb + "\n")
            mt: str = self.new_tmp()
            self.emit("  " + mt + " = select i1 " + mc + ", " +
                      self.llvm_type(nt2) + " " + ma + ", " +
                      self.llvm_type(nt2) + " " + mb + "\n")
            return mt

        # ★ 第44章：print(xs) / str(xs)
        if n.is_list_str:
            el: ast.Type = ast.elem_of(type_of(node_of(n.args)))
            kind: int = 0
            if el.kind == ast.TY_FLOAT:
                kind = 1
            elif el.kind == ast.TY_STR:
                kind = 2
            elif el.kind == ast.TY_BOOL:
                kind = 3
            lv: str = self.gen_expr(node_of(n.args))
            if n.name == "print":
                self.declare_rt("void @pl_print_list(ptr, i64)")
                self.emit("  call void @pl_print_list(ptr " + lv + ", i64 " +
                          str(kind) + ")\n")
                return ""
            self.declare_rt("ptr @pl_list_str(ptr, i64)")
            lt: str = self.new_tmp()
            self.emit("  " + lt + " = call ptr @pl_list_str(ptr " + lv +
                      ", i64 " + str(kind) + ")\n")
            return lt

        if len(n.builtin) > 0:
            return self.gen_builtin_call(n)
        if n.cls is not None:
            return self.gen_new(n)     # ★ 第12章：インスタンス生成

        # ★ 第38章：関数ポインタ越しの呼び出し。
        #   ⚠️ LLVM では呼び先がラベルでもレジスタでも書き方が同じなので、
        #     箱から読んだ値をそのまま置くだけ。declare も要らない。
        #   ⚠️ **ptr として読むこと**（i64 で読むと呼び先が整数になる）。
        if n.is_indirect:
            fp: str = self.new_tmp()
            self.emit("  " + fp + " = load ptr, ptr " + n.ir_name + "\n")
            iargs: list[str] = []
            itypes: list[str] = []
            self.gen_args(n.args, iargs, itypes, True)
            # ⚠️ gen_args は **区切りを要素に埋め込む**ので、
            #    ここは "" で連結すること（", " だと二重になる）
            ia: str = strings.join(iargs, "")
            if type_of(n).kind == ast.TY_NONE:
                self.emit("  call void " + fp + "(" + ia + ")\n")
                return ""
            it: str = self.new_tmp()
            self.emit("  " + it + " = call " + self.llvm_type(type_of(n)) + " " +
                      fp + "(" + ia + ")\n")
            return it

        # ★ 第28章：rc(x) — 数え札を付けてくるむ（sema が ir_name を付けない目印）
        if len(n.ir_name) == 0 and n.name == "rc":
            rv: str = self.gen_expr(node_of(n.args))
            self.declare_rt("ptr @pl_rc_new(ptr)")
            rt2: str = self.new_tmp()
            self.emit("  " + rt2 + " = call ptr @pl_rc_new(ptr " + rv + ")\n")
            return rt2

        # 引数を左から順に評価する（言語仕様 4.5）
        vals: list[str] = []
        atypes: list[str] = []
        self.gen_args(n.args, vals, atypes, True)

        # ★ 第13章：呼ぶ名前は sema が修飾済み
        if n.is_extern:
            ats: str = strings.join(atypes, "")
            # ★ 第27章：失敗しうる関数は、エラー出力の ptr が 1 本増えている
            if n.can_fail:
                if len(ats) > 0:
                    ats = ats + ", ptr"
                else:
                    ats = "ptr"
            self.declare_extern(self.llvm_type(type_of(n)), n.ir_name, ats)
        return self.emit_call(n, strings.join(vals, ""))

    # ── 文の生成 ────────────────────────────────────────────

    def gen_stmt(mut self, n: ast.Node) -> str:
        # 終端済みブロックの後ろに来たら、到達不能ブロックを開く（規約 R7）
        self.ensure_block()

        if n.kind == ast.ND_BLOCK:
            last: str = ""
            st: ast.Node | None = n.body
            while st is not None:
                s: ast.Node = st
                v: str = self.gen_stmt(s)
                if len(v) > 0:
                    last = v
                st = s.next
            return last

        if n.kind == ast.ND_IF:
            self.gen_if(n)
            return ""

        if n.kind == ast.ND_WHILE:
            self.gen_while(n)
            return ""

        if n.kind == ast.ND_RETURN:
            if n.lhs is None:
                self.emit("  ret void\n")      # 規約 R9
            else:
                val: ast.Node = node_of(n.lhs)
                v2: str = self.gen_expr(val)
                self.emit("  ret " + self.llvm_type(type_of(val)) + " " + v2 +
                          "\n")
            self.terminated = True
            return ""

        # ── 第27章：try / except ──
        #
        #   try の本体で失敗したら「振り分け」へ飛び、タグを見て except を選ぶ。
        #   どの except にも当たらなければ、外側の飛び先（外の try か伝播）へ。
        if n.kind == ast.ND_TRY:
            tid: int = self.label_counter
            self.label_counter = self.label_counter + 1
            disp_l: str = "try.dispatch." + str(tid)
            end_l: str = "try.end." + str(tid)

            self.try_stack.append(n)
            self.try_labels.append(disp_l)
            self.gen_stmt(node_of(n.body))
            self.try_stack = pop_nodes(self.try_stack)
            self.try_labels = pop_strs(self.try_labels)
            if not self.terminated:
                self.emit_br(end_l)

            # ── 振り分け ──
            self.emit_label(disp_l)
            slot2: str = self.err_slot()
            tag2: str = self.load_tag(slot2)

            k: int = 0
            ex2: ast.Node | None = n.els
            while ex2 is not None:
                e3: ast.Node = ex2
                hit_l: str = "except." + str(tid) + "." + str(k)
                next_l: str = "try.next." + str(tid) + "." + str(k)
                c2: str = self.new_tmp()
                self.emit("  " + c2 + " = icmp eq i64 " + tag2 + ", " +
                          str(e3.err_tag) + "\n")
                self.emit_cond_br(c2, hit_l, next_l)
                self.emit_label(next_l)
                k = k + 1
                ex2 = e3.next
            # どの except にも当たらなかった → 外側へ渡す
            self.emit_fail_br()

            # ── 各 except の本体 ──
            k2: int = 0
            ex3: ast.Node | None = n.els
            while ex3 is not None:
                e4: ast.Node = ex3
                hit2: str = "except." + str(tid) + "." + str(k2)
                self.emit_label(hit2)
                if len(e4.ir_name) > 0:
                    pv2: str = self.load_payload(slot2)
                    self.emit("  store ptr " + pv2 + ", ptr " + e4.ir_name + "\n")
                self.gen_stmt(node_of(e4.body))
                if not self.terminated:
                    self.emit_br(end_l)
                k2 = k2 + 1
                ex3 = e4.next

            self.emit_label(end_l)
            return ""

        # ── 第27章：raise ──
        if n.kind == ast.ND_RAISE:
            obj: str = self.gen_expr(node_of(n.lhs))

            # ★ 同じ関数の中の try が捕まえるなら、そこへ飛ぶ（Python と同じ）
            catcher: int = -1
            i2: int = len(self.try_stack) - 1
            while i2 >= 0:
                t2: ast.Node = self.try_stack[i2]
                exf: ast.Node | None = t2.els
                while exf is not None:
                    e5: ast.Node = exf
                    if e5.err_tag == n.err_tag and catcher < 0:
                        catcher = i2
                    exf = e5.next
                i2 = i2 - 1

            if catcher >= 0:
                self.store_err(self.err_slot(), n.err_tag, obj)
                self.emit_br(self.try_labels[catcher])
            else:
                self.store_err("%err.out", n.err_tag, obj)
                self.emit_default_ret()
            return ""

        if n.kind == ast.ND_PASS:
            return ""                          # 本当に何も出さない

        # 飛び先は sema が保証している
        if n.kind == ast.ND_BREAK:
            self.emit_br(loop_of(self.loop).break_label)
            return ""
        if n.kind == ast.ND_CONTINUE:
            self.emit_br(loop_of(self.loop).continue_label)
            return ""

        if n.kind == ast.ND_VARDECL:
            # alloca は entry ブロックに出済み（規約 R1）。ここでは store だけ
            v3: str = self.gen_expr(node_of(n.rhs))
            self.gen_store(type_of(n), v3, n.ir_name)
            return ""

        # ★ 第44章：分解代入 q, r = f()
        #   右辺を **1 回だけ**評価し、各要素を取り出してそれぞれの箱に入れる。
        if n.kind == ast.ND_UNPACK:
            uobj: str = self.gen_expr(node_of(n.rhs))
            uty: str = self.tuple_ty(type_of(n))
            uk: int = 0
            uvi: ast.Node | None = n.params
            while uvi is not None:
                uvn: ast.Node = uvi
                upt: str = self.new_tmp()
                self.emit("  " + upt + " = getelementptr " + uty + ", ptr " +
                          uobj + ", i32 0, i32 " + str(uk) + "\n")
                uval: str = self.gen_load(type_of(uvn), upt)
                self.gen_store(type_of(uvn), uval, uvn.ir_name)
                uk = uk + 1
                uvi = uvn.next
            return ""

        if n.kind == ast.ND_ASSIGN:
            v4: str = self.gen_expr(node_of(n.rhs))
            target: ast.Node = node_of(n.lhs)

            # 添字への代入 xs[i] = v（第10章）
            if target.kind == ast.ND_INDEX:
                self.gen_index_store(target, v4)
                return ""

            # フィールドへの代入 t.kind = v（第12章）
            if target.kind == ast.ND_FIELD:
                # 第13章：lexer.counter = v は他モジュールのグローバルへの代入
                if len(target.mod_name) > 0:
                    if target.is_extern:
                        self.declare_extern_global(target)
                    self.gen_store(type_of(n), v4, target.ir_name)
                    return ""
                self.gen_store(type_of(n), v4, self.gen_field_ptr(target))
                return ""

            self.gen_store(type_of(n), v4, target.ir_name)
            return ""

        return self.gen_expr(n)                # 式文

    # ── alloca の収集（規約 R1）────────────────────────────

    def collect_allocas(mut self, n: ast.Node | None) -> None:
        if n is None:
            return
        node: ast.Node = n

        # ⚠️ グローバル変数は alloca しない
        if node.kind == ast.ND_VARDECL and not node.is_global:
            self.allocas.append("  " + node.ir_name + " = alloca " +
                                self.llvm_mem_type(type_of(node)) + "\n")

        # ★ 第44章：分解代入で受け取る名前も、ふつうの局所変数と同じ箱が要る
        if node.kind == ast.ND_UNPACK:
            avi: ast.Node | None = node.params
            while avi is not None:
                avn: ast.Node = avi
                self.allocas.append("  " + avn.ir_name + " = alloca " +
                                    self.llvm_mem_type(type_of(avn)) + "\n")
                avi = avn.next

        # ★ 第27章：except ... as e で束縛する変数にも箱が要る
        if node.kind == ast.ND_EXCEPT and len(node.ir_name) > 0:
            self.allocas.append("  " + node.ir_name + " = alloca " +
                                self.llvm_mem_type(type_of(node)) + "\n")

        # ⚠️ except の並びは next で繋がっている（2 番目以降をここでたどる）
        if node.kind == ast.ND_TRY and node.els is not None:
            ex: ast.Node | None = node_of(node.els).next
            while ex is not None:
                e2: ast.Node = ex
                self.collect_allocas(e2)
                ex = e2.next

        self.collect_allocas(node.lhs)
        self.collect_allocas(node.rhs)
        self.collect_allocas(node.els)
        st: ast.Node | None = node.body
        while st is not None:
            s: ast.Node = st
            self.collect_allocas(s)
            st = s.next

    # ── 関数の生成 ──────────────────────────────────────────

    def gen_func(mut self, n: ast.Node) -> None:
        # 関数ごとに状態をリセットする
        self.tmp_counter = 0
        self.label_counter = 0
        self.terminated = False
        self.loop = None
        self.allocas = []
        self.fn = []

        # ── 第27章：エラー処理の状態 ──
        self.fn_raises = n.err_types is not None
        self.fn_ret = n.type
        self.err_slot_done = False
        self.try_stack = []
        self.try_labels = []
        self.prop_used = False
        if self.fn_raises:
            self.ensure_err_type()

        ir_name: str = n.ir_name

        # ① 引数を alloca にコピーする（規約 R8）
        pm: ast.Node | None = n.params
        while pm is not None:
            p: ast.Node = pm
            self.allocas.append("  " + p.ir_name + " = alloca " +
                                self.llvm_mem_type(type_of(p)) + "\n")
            self.gen_store(type_of(p), "%" + p.name + ".arg", p.ir_name)
            pm = p.next

        # ② ローカル変数の alloca（第5章のまま）
        self.collect_allocas(n.body)

        # ③ 本体
        self.gen_stmt(node_of(n.body))

        # ── 第27章：伝播ブロック（呼び出し元へエラーをそのまま返す）──
        #
        # ★ 使われたときだけ出します（使わないブロックは LLVM が嫌がる）
        if self.prop_used:
            self.emit_label("err.propagate")
            self.ensure_err_type()
            ev: str = self.new_tmp()
            self.emit("  " + ev + " = load %pl.err, ptr %err.slot\n")
            self.emit("  store %pl.err " + ev + ", ptr %err.out\n")
            self.emit_default_ret()

        # ④ 終端されていなければ終端する（規約 R6）
        if not self.terminated:
            if type_of(n).kind == ast.TY_NONE:
                self.emit("  ret void\n")      # 規約 R9
            else:
                # 全経路 return は sema が保証済み
                self.emit("  unreachable\n")

        # ⑤ 組み立て
        out: list[str] = []
        out.append("\ndefine " + self.llvm_type(type_of(n)) + " @" + ir_name +
                   "(")
        first: bool = True
        pm2: ast.Node | None = n.params
        while pm2 is not None:
            p2: ast.Node = pm2
            sep: str = ", "
            if first:
                sep = ""
            out.append(sep + self.llvm_type(type_of(p2)) + " %" + p2.name +
                       ".arg")
            first = False
            pm2 = p2.next
        # ★ 第27章：失敗しうる関数は、エラー出力ポインタを 1 本余分に取る
        if self.fn_raises:
            sep2: str = ", "
            if first:
                sep2 = ""
            out.append(sep2 + "ptr %err.out")
        out.append(") {\nentry:\n")
        out.append(strings.join(self.allocas, ""))
        out.append(strings.join(self.fn, ""))
        out.append("}\n")
        self.body.append(strings.join(out, ""))

    # グローバル変数を出力する（言語仕様 6.2）
    def gen_global(mut self, n: ast.Node) -> None:
        rhs: ast.Node = node_of(n.rhs)
        if type_of(n).kind == ast.TY_STR:
            lab: str = self.intern_str(rhs.sval)
            self.globals_.append(n.ir_name + " = global ptr " + lab + "\n")
            return
        # ★ float は値ではなく、字句解析器が正規化した文字列を出す
        if type_of(n).kind == ast.TY_FLOAT:
            self.globals_.append(n.ir_name + " = global double " +
                                 rhs.sval + "\n")
            return
        self.globals_.append(n.ir_name + " = global " +
                             self.llvm_mem_type(type_of(n)) + " " +
                             str(rhs.ival) + "\n")

    # C の main を出力する（ir-conventions.md 7 節の方式 A）
    #
    # ⚠️ 第13章：これを出すのは入口モジュールだけ
    def gen_c_main(mut self, main_ir_name: str) -> None:
        self.tmp_counter = 0

        # ★ 第14章：argc / argv を受け取り、ランタイムに預ける
        self.declare_rt("void @pl_set_args(i64, ptr)")

        out: list[str] = []
        out.append("\n")
        out.append("define i32 @main(i32 %argc, ptr %argv) {\n")
        out.append("entry:\n")

        a: str = self.new_tmp()
        out.append("  " + a + " = sext i32 %argc to i64\n")
        out.append("  call void @pl_set_args(i64 " + a + ", ptr %argv)\n")

        t0: str = self.new_tmp()
        out.append("  " + t0 + " = call i64 @" + main_ir_name + "()\n")

        t1: str = self.new_tmp()
        out.append("  " + t1 + " = trunc i64 " + t0 + " to i32\n")

        # ★ 第31章：下位 8 ビットに切り詰める（言語仕様 6.1）。
        #   POSIX は終了コードを勝手に & 0xFF するが、Windows は 32 ビットを
        #   そのまま返すので、揃えておかないと OS で結果が変わる。
        t2: str = self.new_tmp()
        out.append("  " + t2 + " = and i32 " + t1 + ", 255\n")

        out.append("  ret i32 " + t2 + "\n")
        out.append("}\n")
        self.body.append(strings.join(out, ""))


# ── 入口 ───────────────────────────────────────────────────
#
# モジュール 1 つぶんの IR を作る（★ 1 ファイル = 1 モジュール = 1 つの .ll）
def codegen(mod: module.Module, main_ir_name: str, triple: str) -> str:
    root: ast.Node = node_of(mod.ast)
    e: Emitter = Emitter(triple)

    # ① ヘッダ
    e.header.append("; Generated by " + langinfo.cc() + "\n")
    e.header.append("source_filename = \"" + mod.path + "\"\n")

    # ⚠️ 規約 R11：target triple は必ず出力する
    if len(triple) > 0:
        e.header.append("target triple = \"" + triple + "\"\n")

    # ② クラスの型定義（★ 使う側より先に、モジュールの先頭に出す）
    d: ast.Node | None = root.body
    while d is not None:
        n: ast.Node = d
        # ⚠️ 第40章：ジェネリックなテンプレートは出さない。
        #   K や V が何なのか決まっていないので、構造体の形が作れない。
        #   出すのは実体（Box$int など）だけ。
        if n.kind == ast.ND_CLASS and n.targs is None:
            e.gen_class_type(class_of(n.cls))
        d = n.next

    # ⑤ グローバル変数と関数定義
    d2: ast.Node | None = root.body
    while d2 is not None:
        n2: ast.Node = d2
        if n2.kind == ast.ND_VARDECL:
            e.gen_global(n2)
        d2 = n2.next

    d3: ast.Node | None = root.body
    while d3 is not None:
        n3: ast.Node = d3
        if n3.kind == ast.ND_FUNC:
            # ★ 第14章：extern は宣言だけを出す
            if n3.body is None:
                atypes: list[str] = []
                first: bool = True
                pm: ast.Node | None = n3.params
                while pm is not None:
                    p: ast.Node = pm
                    sep: str = ", "
                    if first:
                        sep = ""
                    atypes.append(sep + e.llvm_type(type_of(p)))
                    first = False
                    pm = p.next
                e.declare_extern(e.llvm_type(type_of(n3)), n3.name,
                                 strings.join(atypes, ""))
            elif n3.targs is None:
                # ⚠️ ジェネリックなテンプレートは出さない（第43章）
                e.gen_func(n3)
        elif n3.kind == ast.ND_CLASS and n3.targs is None:
            m: ast.Node | None = n3.body
            while m is not None:
                mm: ast.Node = m
                if mm.kind == ast.ND_FUNC:
                    e.gen_func(mm)
                m = mm.next
        d3 = n3.next

    # ⚠️ C の main を出すのは入口モジュールだけ
    if len(main_ir_name) > 0:
        e.gen_c_main(main_ir_name)

    # 4 つのバッファを規定の順に連結する
    out: list[str] = []
    out.append(strings.join(e.header, ""))
    out.append(strings.join(e.globals_, ""))
    out.append(strings.join(e.decls, ""))
    out.append(strings.join(e.body, ""))
    return strings.join(out, "")


# ── 小道具 ─────────────────────────────────────────────────

def hex2(v: int) -> str:
    digits: str = "0123456789ABCDEF"
    return digits[(v // 16) % 16] + digits[v % 16]

def node_of(n: ast.Node | None) -> ast.Node:
    if n is None:
        panic("codegen: ノードがありません")
        return ast.new_node(ast.ND_PASS, None)
    else:
        return n

def type_of(n: ast.Node) -> ast.Type:
    t: ast.Type | None = n.type
    if t is None:
        panic("codegen: 型が埋まっていません（sema を通していない？）")
        return ast.Type(ast.TY_INT)
    else:
        return t

# 生成中の関数の戻り型（第27章。まだ関数の外なら None 型として扱う）
# スタックから最後の 1 つを外す（list に pop がまだ無いため。第27章）
def pop_nodes(xs: list[ast.Node]) -> list[ast.Node]:
    out: list[ast.Node] = []
    i: int = 0
    while i < len(xs) - 1:
        out.append(xs[i])
        i = i + 1
    return out

def pop_strs(xs: list[str]) -> list[str]:
    out: list[str] = []
    i: int = 0
    while i < len(xs) - 1:
        out.append(xs[i])
        i = i + 1
    return out

def type_or_none(t: ast.Type | None) -> ast.Type:
    if t is None:
        return ast.Type(ast.TY_NONE)
    else:
        return t

def type_of_field(f: ast.Field) -> ast.Type:
    t: ast.Type | None = f.type
    if t is None:
        panic("codegen: フィールドの型がありません")
        return ast.Type(ast.TY_INT)
    else:
        return t

def class_of(c: ast.Class | None) -> ast.Class:
    if c is None:
        panic("codegen: クラスがありません")
        return ast.Class("", None)
    else:
        return c

def field_of(f: ast.Field | None) -> ast.Field:
    if f is None:
        panic("codegen: フィールドが解決されていません")
        return ast.Field("", None)
    else:
        return f

def loop_of(l: LoopCtx | None) -> LoopCtx:
    if l is None:
        panic("codegen: ループの外に break / continue があります")
        return LoopCtx(None, "", "")
    else:
        return l
