# check.po — stage1 の型検査器を動かす入口（第18章）
#
#   ./build/stage1-check foo.po
#
# ★ C 版の `poloniumc --check foo.po` と**同じ出力**を目指します。
#   エラーが無ければ何も出さず、終了コード 0。
import io
import sys
import module
import sema

def main() -> int:
    args: list[str] = sys.argv()
    if len(args) < 2:
        print("使い方: stage1-check <入力.po>")
        return 1

    path: str = args[1]
    mods: module.Module | None = module.load_modules(path)
    entry: module.Module | None = module.entry_of(mods, path)
    sema.sema_program(mods, entry)
    return 0
