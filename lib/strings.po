# strings.po — 文字列ヘルパ（第14章）
#
# ★ このファイルに C は 1 行もありません。
#   第9章（str と +）・第10章（list[T]）・第11章（for / range）で入れた
#   機能の組み合わせだけで書けています。
#
# ⚠️ 速度は考えていません。out = out + s[i] は毎回新しい文字列を確保するので
#    substr は O(n^2) です。docs/chapters/ch14-stdlib.md 14.5 節のとおり、
#    速度は第20章（ブートストラップ）の後に測ってから直します。

# i 番目のバイトを int で返す（確保しない。第15章 15.7 節）
#
# ★ 言語には足していません。第14章で作った extern でランタイムを呼ぶだけです。
#   s[i] は 1 文字の str を「毎回ヒープに確保して」返すので、
#   字句解析器のように 1 文字ずつ回るコードではこちらを使います。
extern def pl_byte_at(s: str, i: int) -> int
extern def pl_str_join(xs: list[str], sep: str) -> str

def byte_at(s: str, i: int) -> int:
    return pl_byte_at(s, i)


# s の start から count 文字を取り出す（範囲外は切り詰める）
def substr(s: str, start: int, count: int) -> str:
    n: int = len(s)
    i: int = start
    if i < 0:
        i = 0
    stop: int = start + count
    if stop > n:
        stop = n
    out: str = ""
    while i < stop:
        out = out + s[i]
        i = i + 1
    return out

# 位置 at から sub が始まっているか
#
# ★ 第15章：比較は byte_at（int）で行います。s[i] は 1 文字の str を
#   毎回ヒープに確保するので、内側のループで使うと効いてきます（15.7 節）。
def matches_at(s: str, sub: str, at: int) -> bool:
    n: int = len(s)
    m: int = len(sub)
    if at < 0 or at + m > n:
        return False
    i: int = 0
    while i < m:
        if byte_at(s, at + i) != byte_at(sub, i):
            return False
        i = i + 1
    return True

# sub が最初に現れる位置。無ければ -1
#
# ★ 「見つからない」を -1 で表すのは T | None が無いからです（第15章で直せる形）。
def find(s: str, sub: str) -> int:
    n: int = len(s)
    m: int = len(sub)
    if m == 0:
        return 0
    i: int = 0
    while i + m <= n:
        if matches_at(s, sub, i):
            return i
        i = i + 1
    return -1

def contains(s: str, sub: str) -> bool:
    return find(s, sub) >= 0

def startswith(s: str, prefix: str) -> bool:
    return matches_at(s, prefix, 0)

def endswith(s: str, suffix: str) -> bool:
    return matches_at(s, suffix, len(s) - len(suffix))

# sep で分割する。sep が空なら 1 文字ずつに分ける
def split(s: str, sep: str) -> list[str]:
    out: list[str] = []
    n: int = len(s)
    m: int = len(sep)

    if m == 0:
        for c in s:
            out.append(c)
        return out

    start: int = 0
    i: int = 0
    while i + m <= n:
        if matches_at(s, sep, i):
            out.append(substr(s, start, i - start))
            i = i + m
            start = i
        else:
            i = i + 1
    out.append(substr(s, start, n - start))
    return out

# ★ 第15章：ランタイムに任せます。
#   out = out + xs[i] を繰り返すと O(n^2) になり、セルフホストの
#   IR 出力（何万行も組み立てる）で効いてきます。
#   「list[str] に溜めて最後に join する」が Polonium での文字列組み立ての形です。
def join(xs: list[str], sep: str) -> str:
    return pl_str_join(xs, sep)

def is_space(c: str) -> bool:
    return c == " " or c == "\t" or c == "\n" or c == "\r"

def is_space_byte(b: int) -> bool:
    return b == 32 or b == 9 or b == 10 or b == 13

# 前後の空白を落とす
def strip(s: str) -> str:
    n: int = len(s)
    start: int = 0
    while start < n and is_space_byte(byte_at(s, start)):
        start = start + 1
    stop: int = n
    while stop > start and is_space_byte(byte_at(s, stop - 1)):
        stop = stop - 1
    return substr(s, start, stop - start)

# 桁揃え（第16章）。printf の %3d / %-8s の代わり。
#
# ★ 言語に書式指定を足すのではなく、ライブラリの関数で済ませます
#   （第14章 14.1 節の境界線）。
def lpad(s: str, width: int) -> str:
    out: str = s
    while len(out) < width:
        out = " " + out
    return out

def rpad(s: str, width: int) -> str:
    out: str = s
    while len(out) < width:
        out = out + " "
    return out

def repeat(s: str, times: int) -> str:
    out: str = ""
    for i in range(times):
        out = out + s
    return out

# old をすべて new に置き換える
def replace(s: own str, old: str, new: str) -> str:
    if len(old) == 0:
        return s
    return join(split(s, old), new)
