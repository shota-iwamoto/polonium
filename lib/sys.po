# sys.po — プロセス（第14章）
#
# ★ この 2 つが無いと、Polonium 製コンパイラは「コマンド」になれません
#   （docs/design/self-hosting.md 3.4）。

extern def pl_argv() -> list[str]
extern def pl_system(cmd: str) -> int
extern def pl_getenv(name: str) -> str

# コマンドライン引数（argv[0] はプログラム名）
def argv() -> list[str]:
    return pl_argv()

def argc() -> int:
    return len(pl_argv())

# 環境変数を読む（設定されていなければ空文字列）
def getenv(name: str) -> str:
    return pl_getenv(name)

# 外部コマンドを実行して終了コードを返す
def run(cmd: str) -> int:
    return pl_system(cmd)
